---
/**
 * "Hangi rolün yolunu görmek istersin?" — native radios styled as cards.
 *
 * Home: open until a role is chosen, then a one-line bar ("Yolun: Product
 * Manager · Değiştir") that reopens it. Settings: always open.
 *
 * Without JavaScript nothing can be stored, so the picker hides itself and the
 * map stays in Keşif mode — the full, ordered list of every category.
 */
import { ROLE_IDS, ROLE_LABEL, ROLE_STATES, type RoleState } from "~/data/role-ids";
import { ROLE_BY_ID } from "~/data/roles";
import { getRoutes } from "~/lib/routes";

interface Props {
  variant?: "home" | "settings";
}

const { variant = "home" } = Astro.props;

const routes = await getRoutes();

// What the live region says after a change, so a screen reader hears that the
// map behind the picker was rearranged.
const announce = (state: RoleState) => {
  const route = routes.find((path) => path.state === state)!;
  if (state === "all") return `Keşif modu: harita tüm ${route.stops.length} kategoriyi gösteriyor.`;
  const core = route.stops.filter((stop) => stop.tier === "temel").length;
  return `Harita ${ROLE_LABEL[state].name} yoluna göre düzenlendi: ${route.stops.length} durak, ${core} tanesi temel.`;
};

const options = [
  ...ROLE_IDS.map((id) => ({ id, name: ROLE_LABEL[id].name, tr: ROLE_LABEL[id].tr, focus: ROLE_BY_ID.get(id)!.focus })),
  { id: "all" as const, name: ROLE_LABEL.all.name, tr: ROLE_LABEL.all.tr, focus: "Önce etrafa bakmak istiyorum." },
];
const panelId = `rol-paneli-${variant}`;
---

<section class:list={["role-picker", `role-picker--${variant}`]} id={variant === "home" ? "rol-secimi" : undefined} data-role-picker>
  {
    variant === "home" && (
      <div class="role-picker__bar glass">
        <p class="role-picker__current">
          <span class="role-picker__eyebrow">Yolun</span>
          {ROLE_STATES.map((state) => (
            <strong data-for-role={state}>{ROLE_LABEL[state].name}</strong>
          ))}
        </p>
        <button type="button" class="role-picker__toggle" aria-expanded="false" aria-controls={panelId} data-role-toggle>
          Değiştir
        </button>
      </div>
    )
  }

  <div class="role-picker__panel glass" id={panelId} data-role-panel>
    <fieldset class="role-picker__set">
      <legend class="role-picker__legend">Hangi rolün yolunu görmek istersin?</legend>
      <p class="role-picker__hint">
        Harita, sıra ve öncelikler rolüne göre değişir. İlerlemen her rolde aynı kalır.
      </p>
      <div class="role-picker__options">
        {
          options.map((option) => (
            <label class:list={["role-option", { "role-option--explore": option.id === "all" }]}>
              <input
                class="role-option__input"
                type="radio"
                name={`rol-${variant}`}
                value={option.id}
                data-role-option
                data-announce={announce(option.id)}
              />
              <span class="role-option__name">{option.name}</span>
              <span class="role-option__tr">{option.tr}</span>
              <span class="role-option__focus">“{option.focus}”</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    {
      variant === "home" && (
        <div class="role-picker__done">
          <button type="button" class="role-picker__close" data-role-close>
            Tamam
          </button>
        </div>
      )
    }
  </div>

  <p class="sr-only" aria-live="polite" data-role-announce></p>
</section>

<script>
  import { $role, initRole, setRole } from "~/lib/role";
  import { isRoleState } from "~/data/role-ids";

  initRole();

  for (const picker of document.querySelectorAll<HTMLElement>("[data-role-picker]")) {
    const options = picker.querySelectorAll<HTMLInputElement>("[data-role-option]");
    const toggle = picker.querySelector<HTMLButtonElement>("[data-role-toggle]");
    const close = picker.querySelector<HTMLButtonElement>("[data-role-close]");
    const live = picker.querySelector<HTMLElement>("[data-role-announce]");

    const setOpen = (open: boolean) => {
      picker.classList.toggle("is-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
    };

    $role.subscribe((state) => {
      for (const option of options) option.checked = option.value === state;
    });

    // On the home page the first choice hides the panel (CSS on html[data-role]).
    // Arrow keys fire "change" on every radio they pass, so a keyboard user
    // would lose the panel, and focus, on the first step. Keep it open for
    // keys; after a click, hand focus to "Değiştir" instead of <body>.
    let byPointer = false;
    picker.addEventListener("pointerdown", () => (byPointer = true));
    picker.addEventListener("keydown", () => (byPointer = false));

    for (const option of options) {
      option.addEventListener("change", () => {
        if (!option.checked || !isRoleState(option.value)) return;
        const wasClosed = toggle !== null && !picker.classList.contains("is-open");
        setRole(option.value);
        if (live) live.textContent = option.dataset.announce ?? "";
        if (!wasClosed) return;
        if (byPointer) toggle?.focus();
        else setOpen(true);
      });
    }

    toggle?.addEventListener("click", () => {
      const open = !picker.classList.contains("is-open");
      setOpen(open);
      if (open) picker.querySelector<HTMLInputElement>("[data-role-option]:checked")?.focus();
    });

    close?.addEventListener("click", () => {
      setOpen(false);
      toggle?.focus();
    });

    // Other parts of the page ("Değiştir" on the note, the finished-route card)
    // ask the picker to open.
    document.addEventListener("role-picker:open", () => {
      setOpen(true);
      picker.scrollIntoView({ block: "nearest", behavior: "smooth" });
      (picker.querySelector<HTMLInputElement>("[data-role-option]:checked") ?? options[0])?.focus();
    });
  }
</script>

<style>
  /* No JavaScript, no storage: the picker could not keep a choice. */
  :global(html:not([data-js])) .role-picker {
    display: none;
  }

  .role-picker__bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-2) var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
  }

  /* Home: once a role is chosen, the bar replaces the panel until reopened. */
  :global(html[data-role]) .role-picker--home .role-picker__bar {
    display: flex;
  }

  :global(html[data-role]) .role-picker--home:not(.is-open) .role-picker__panel {
    display: none;
  }

  :global(html[data-role]) .role-picker--home.is-open .role-picker__panel {
    margin-block-start: var(--spacing-3);
  }

  .role-picker__current {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-2);
    margin: 0;
    min-width: 0;
  }

  .role-picker__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-action);
  }

  .role-picker__current strong {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-text);
  }

  .role-picker__toggle,
  .role-picker__close {
    flex: none;
    min-block-size: 44px;
    padding-inline: var(--spacing-4);
    border: 1px solid var(--c-control-border);
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--c-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .role-picker__toggle:hover,
  .role-picker__close:hover {
    border-color: var(--c-action);
    color: var(--c-action-hover);
  }

  .role-picker__panel {
    padding: var(--spacing-4);
    border-radius: 1.5rem;
  }

  @media (min-width: 48rem) {
    .role-picker__panel {
      padding: var(--spacing-6);
    }
  }

  .role-picker--settings .role-picker__panel {
    padding: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    border: 0;
  }

  .role-picker__set {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .role-picker__legend {
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--c-text);
  }

  .role-picker--settings .role-picker__legend {
    font-size: var(--text-base);
  }

  .role-picker__hint {
    margin-block: var(--spacing-1) var(--spacing-4);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .role-picker__options {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--spacing-3);
  }

  .role-option {
    position: relative;
    display: grid;
    gap: var(--spacing-1);
    align-content: start;
    min-block-size: 44px;
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--c-control-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-sunken);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--e-out),
      background-color var(--dur-fast) var(--e-out);
  }

  .role-option:hover {
    border-color: var(--c-action);
  }

  /* The radio itself stays in the accessibility tree and takes focus; the card
     shows its state. Selected = action border + tick, never colour alone. */
  .role-option__input {
    position: absolute;
    inset-block-start: var(--spacing-3);
    inset-inline-end: var(--spacing-3);
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin: 0;
    accent-color: var(--c-action);
  }

  .role-option:has(.role-option__input:checked) {
    border-color: var(--c-action);
    box-shadow: inset 0 0 0 1px var(--c-action);
    background-color: var(--c-surface-overlay);
  }

  .role-option:has(.role-option__input:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .role-option__name {
    padding-inline-end: var(--spacing-6);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-text);
  }

  .role-option__tr {
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .role-option__focus {
    margin-block-start: var(--spacing-1);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--c-text-muted);
  }

  .role-option--explore {
    border-style: dashed;
  }

  .role-picker__done {
    display: none;
    justify-content: flex-end;
    margin-block-start: var(--spacing-4);
  }

  :global(html[data-role]) .role-picker--home .role-picker__done {
    display: flex;
  }
</style>
