---
import DiagramFigure from "./DiagramFigure.astro";

// Widths are proportional to the counts, so the shape itself carries the drop.
const steps = [
  { label: "Ziyaret", count: "10.000", half: 260 },
  { label: "Ürüne baktı", count: "4.200", half: 176 },
  { label: "Sepete ekledi", count: "980", half: 96 },
  { label: "Ödemeye geçti", count: "540", half: 62 },
  { label: "Satın aldı", count: "310", half: 42 },
];
---

<DiagramFigure
  label="Dönüşüm hunisi şeması"
  caption="Her adımda bir grup kullanıcı düşer. Huninin işe yaradığı yer toplam dönüşüm oranı değil, en dik düşüşün nerede olduğudur — burada sepetten ödemeye geçişte dörtte üçü kaybediliyor ve iyileştirme çabası oraya harcanır. Dikkat: huni, kullanıcıların gerçekten bu sırayla ilerlediğini varsayar; çoğu üründe insanlar ileri geri gezer, o yüzden huni bir gerçeklik değil, bir ölçüm çerçevesidir."
>
  <svg viewBox="0 0 640 240" role="img" aria-label="Ziyaretten satın almaya beş adımda daralan dönüşüm hunisi">
    <title>Dönüşüm hunisi</title>

    {
      steps.map((step, index) => {
        const y = 12 + index * 44;
        const next = steps[index + 1];
        const isSteepest = index === 2;
        return (
          <>
            <path
              class:list={["dg-box", { "dg-box--progress": isSteepest }]}
              d={
                next
                  ? `M${320 - step.half} ${y} H${320 + step.half} L${320 + next.half} ${y + 36} H${320 - next.half} Z`
                  : `M${320 - step.half} ${y} H${320 + step.half} V${y + 36} H${320 - step.half} Z`
              }
            />
            <text class="dg-label" x={320} y={y + 23} text-anchor="middle">
              {step.count}
            </text>
            <text class="dg-sub" x={8} y={y + 23}>
              {step.label}
            </text>
          </>
        );
      })
    }

    <text class="dg-sub dg-progress" x="632" y="140" text-anchor="end">en dik düşüş burada</text>
    <text class="dg-sub" x="8" y="232">Aranan sayı toplam oran değil, en dik düşüşün yeri.</text>
  </svg>
</DiagramFigure>
