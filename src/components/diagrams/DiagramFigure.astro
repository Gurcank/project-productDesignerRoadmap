---
/**
 * Shell for every inline diagram (SPEC Faz 5).
 *
 * Diagrams are components, never edits to the imported markdown: generated
 * content is rewritten on every import and `import:check` guards it (ADR-002).
 * ~/data/diagrams.ts says which section gets which figure.
 *
 * The caption is not decoration — it carries the same information in prose, so
 * the drawing is never the only thing saying it.
 */
interface Props {
  /** Accessible name; also what a screen reader announces for the graphic. */
  label: string;
  caption: string;
}

const { label, caption } = Astro.props;
---

<figure class="diagram">
  {/* tabindex makes the scroll container reachable by keyboard — an overflow
      box that only a mouse can pan is unusable without one (WCAG 2.1.1). */}
  <div class="diagram__canvas" tabindex="0" role="group" aria-label={label}>
    <slot />
  </div>
  <p class="diagram__scroll-hint" aria-hidden="true">Şekli görmek için yana kaydır →</p>
  <figcaption class="diagram__caption">{caption}</figcaption>
  {/* Data primitives put their table here (DataTable.astro). */}
  <slot name="data" />
</figure>

<style is:global>
  .diagram {
    margin-block: var(--spacing-8);
    padding: var(--spacing-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-raised);
  }

  /* Diagrams are the one block besides tables allowed to be wider than the
     reading column; below their minimum they scroll rather than shrink the
     labels into illegibility. */
  .diagram__canvas {
    overflow-x: auto;
  }

  /* Never below the authored viewBox width. Letting the SVG shrink to the phone
     scaled 13px labels down to 6.5px — legible only in theory. Below this the
     figure scrolls instead, the same bargain tables make. */
  .diagram__canvas svg {
    display: block;
    inline-size: 100%;
    /* A primitive narrower than 40rem passes its own width (--dg-min) so it keeps
       its authored size instead of being blown up. */
    min-inline-size: var(--dg-min, 40rem);
    block-size: auto;
  }

  .diagram__caption {
    margin-block-start: var(--spacing-3);
    padding-block-start: var(--spacing-3);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* One shared vocabulary so ten diagrams read as one system. */
  .dg-box {
    fill: var(--c-surface-sunken);
    stroke: var(--c-route-line);
    stroke-width: 1.5;
  }

  .dg-box--accent {
    stroke: var(--c-action);
  }

  .dg-box--progress {
    stroke: var(--c-progress);
  }

  .dg-line {
    stroke: var(--c-route-line);
    stroke-width: 1.5;
    fill: none;
  }

  .dg-line--accent {
    stroke: var(--c-action);
  }

  .dg-label {
    fill: var(--c-text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
  }

  .dg-sub {
    fill: var(--c-text-muted);
    font-family: var(--font-sans);
    font-size: 11px;
  }

  .dg-accent {
    fill: var(--c-action);
  }

  .dg-progress {
    fill: var(--c-progress-text);
  }

  .dg-line--progress {
    stroke: var(--c-progress);
  }

  .dg-line--dashed {
    stroke-dasharray: 5 4;
  }

  .dg-fill-action {
    fill: var(--c-action);
  }

  .dg-on-action {
    fill: var(--c-on-action);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
  }

  .dg-dot {
    fill: var(--c-text);
  }

  .dg-sub.dg-strong {
    fill: var(--c-text);
  }

  /* Heat steps: the surface mixed towards the action colour. Text on steps 3–4
     switches to the dark ink (Heatmap.astro) so each cell keeps its contrast. */
  .dg-heat {
    stroke: var(--c-border);
  }
  .dg-heat--none {
    fill: var(--c-surface-sunken);
  }
  .dg-heat--0 {
    fill: color-mix(in oklab, var(--c-action) 12%, var(--c-surface-sunken));
  }
  .dg-heat--1 {
    fill: color-mix(in oklab, var(--c-action) 28%, var(--c-surface-sunken));
  }
  .dg-heat--2 {
    fill: color-mix(in oklab, var(--c-action) 42%, var(--c-surface-sunken));
  }
  .dg-heat--3 {
    fill: color-mix(in oklab, var(--c-action) 78%, var(--c-surface-sunken));
  }
  .dg-heat--4 {
    fill: var(--c-action);
  }

  /* Names of numbered points (Matrix2x2), in HTML so they wrap and never collide. */
  .dg-legend {
    display: grid;
    gap: var(--spacing-1);
    max-inline-size: 28rem;
    margin: var(--spacing-3) auto 0;
    padding: 0;
    list-style: none;
    counter-reset: point;
    font-size: var(--text-sm);
    color: var(--c-text);
  }

  .dg-legend li {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    counter-increment: point;
  }

  .dg-legend li::before {
    content: counter(point);
    flex: none;
    display: inline-grid;
    place-items: center;
    inline-size: 1.4rem;
    block-size: 1.4rem;
    border-radius: 50%;
    background-color: var(--c-action);
    color: var(--c-on-action);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .dg-key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    margin: var(--spacing-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--c-text);
  }

  .dg-key li::before {
    content: "";
    display: inline-block;
    inline-size: 0.9rem;
    block-size: 0.9rem;
    margin-inline-end: var(--spacing-2);
    border: 1.5px solid var(--c-action);
    border-radius: 3px;
    vertical-align: -0.1em;
  }

  .dg-key li[data-tone="progress"]::before {
    border-color: var(--c-progress);
    border-style: dashed;
  }

  /* Wide figures scroll on a phone; say so, once, under the drawing. */
  .diagram__scroll-hint {
    display: none;
    margin-block-start: var(--spacing-2);
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  @media (max-width: 40rem) {
    .diagram:has(svg:not(.dg-narrow)) .diagram__scroll-hint {
      display: block;
    }
  }

  .diagram__data {
    margin-block-start: var(--spacing-3);
    border-top: 1px solid var(--c-border);
    padding-block-start: var(--spacing-2);
  }

  .diagram__data summary {
    display: inline-flex;
    align-items: center;
    min-block-size: 32px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--c-text);
    cursor: pointer;
  }

  .diagram__data .table-scroll {
    margin-block-start: var(--spacing-2);
  }

  /* Diagrams never dim with opacity: a multiplier makes the rendered contrast
     something other than what the token says, which is how the roadmap's
     pending nodes failed an axe scan while measuring fine at token level. */
</style>
