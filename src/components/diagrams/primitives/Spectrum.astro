---
/**
 * A scale between two ends: predictive ↔ adaptive, qualitative ↔
 * quantitative, sync ↔ async. Marks sit along it; each mark's name is under
 * the line, its position is the claim. Mark labels alternate above and below
 * so neighbours never collide at phone width.
 */
import DiagramFigure from "../DiagramFigure.astro";
import { wrap } from "./util";

interface End {
  title: string;
  sub?: string;
}

interface Mark {
  label: string;
  /** 0 = left end, 1 = right end. */
  at: number;
}

interface Props {
  label: string;
  caption: string;
  left: End;
  right: End;
  marks: Mark[];
}

const { label, caption, left, right, marks } = Astro.props;
const X0 = 24;
const X1 = 336;
const LINE_Y = 96;
const placed = [...marks]
  .sort((a, b) => a.at - b.at)
  .map((mark, i) => ({ ...mark, x: X0 + Math.min(1, Math.max(0, mark.at)) * (X1 - X0), above: i % 2 === 0, lines: wrap(mark.label, 96, "sub", 2) }));
---

<DiagramFigure label={label} caption={caption}>
  <svg class="dg-narrow" viewBox="0 0 360 176" role="img" aria-label={label}>
    <title>{label}</title>
    <text class="dg-label" x={X0} y="20">{left.title}</text>
    {left.sub && <text class="dg-sub" x={X0} y="36">{left.sub}</text>}
    <text class="dg-label" x={X1} y="20" text-anchor="end">{right.title}</text>
    {right.sub && <text class="dg-sub" x={X1} y="36" text-anchor="end">{right.sub}</text>}

    <path class="dg-line dg-line--accent" d={`M${X0} ${LINE_Y} H${X1}`} stroke-width="2" />
    <path class="dg-line dg-line--accent" d={`M${X0 + 8} ${LINE_Y - 6} l-8 6 8 6 M${X1 - 8} ${LINE_Y - 6} l8 6 -8 6`} stroke-linejoin="round" />
    {
      placed.map((mark) => (
        <>
          <circle class="dg-dot" cx={mark.x} cy={LINE_Y} r="5" />
          <path class="dg-line" d={`M${mark.x} ${mark.above ? LINE_Y - 8 : LINE_Y + 8} V${mark.above ? LINE_Y - 22 : LINE_Y + 22}`} />
          {mark.lines.map((line, i) => (
            <text class="dg-sub dg-strong" x={Math.min(X1 - 30, Math.max(X0 + 30, mark.x))} y={mark.above ? LINE_Y - 28 - (mark.lines.length - 1 - i) * 13 : LINE_Y + 36 + i * 13} text-anchor="middle">
              {line}
            </text>
          ))}
        </>
      ))
    }
  </svg>
</DiagramFigure>
