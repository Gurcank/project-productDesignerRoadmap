---
/**
 * One thing in the middle, what it talks to around it: a system context
 * diagram, a stakeholder ring, an ecosystem. Built at phone width (360): up to
 * three satellites above and three below, each joined to the centre by a line.
 * The relationship ("sipariş verir") is written inside the satellite box, not
 * on the line — floating line labels collide at this width; a box does not.
 */
import DiagramFigure from "../DiagramFigure.astro";
import { boxClass, wrap, type Tone } from "./util";

interface Node {
  title: string;
  /** The relationship to the centre, in a few words. */
  rel?: string;
  tone?: Tone;
}

interface Props {
  label: string;
  caption: string;
  center: { title: string; sub?: string };
  /** At most three. */
  top: Node[];
  /** At most three. */
  bottom?: Node[];
}

const { label, caption, center, top, bottom = [] } = Astro.props;
if (top.length > 3 || bottom.length > 3) throw new Error("Hub: üstte ve altta en çok üçer öğe");

const BOX_W = 108;
const BOX_H = 76;
const COLS = [6, 126, 246];
const TOP_Y = 8;
const CENTER_Y = TOP_Y + BOX_H + 44;
const CENTER_H = 58;
const BOTTOM_Y = CENTER_Y + CENTER_H + 44;
const height = (bottom.length ? BOTTOM_Y + BOX_H : CENTER_Y + CENTER_H) + 8;
const CX = 90;
const CW = 180;

// Centre the row: one item sits in the middle column, two in the outer ones.
const columnsFor = (n: number) => (n === 1 ? [COLS[1]!] : n === 2 ? [COLS[0]!, COLS[2]!] : COLS);
const place = (nodes: Node[], y: number) =>
  nodes.map((node, i) => ({
    ...node,
    x: columnsFor(nodes.length)[i]!,
    y,
    title: wrap(node.title, BOX_W - 14, "label", 2),
    rel: node.rel ? wrap(node.rel, BOX_W - 14, "sub", 2) : [],
  }));
const above = place(top, TOP_Y);
const below = place(bottom, BOTTOM_Y);
const centerTitle = wrap(center.title, CW - 20, "label", 1);
const centerSub = center.sub ? wrap(center.sub, CW - 20, "sub", 1) : [];
---

<DiagramFigure label={label} caption={caption}>
  <svg class="dg-narrow" viewBox={`0 0 360 ${height}`} role="img" aria-label={label}>
    <title>{label}</title>
    {
      [...above, ...below].map((n) => {
        const fromY = n.y === TOP_Y ? TOP_Y + BOX_H : BOTTOM_Y;
        const toY = n.y === TOP_Y ? CENTER_Y : CENTER_Y + CENTER_H;
        const toX = Math.min(CX + CW - 12, Math.max(CX + 12, n.x + BOX_W / 2));
        return <path class="dg-line" d={`M${n.x + BOX_W / 2} ${fromY} L${toX} ${toY}`} />;
      })
    }
    <rect class={boxClass("accent")} x={CX} y={CENTER_Y} width={CW} height={CENTER_H} rx="10" stroke-width="2" />
    <text class="dg-label" x={CX + CW / 2} y={CENTER_Y + (centerSub.length ? 25 : 34)} text-anchor="middle">{centerTitle[0]}</text>
    {centerSub.length > 0 && <text class="dg-sub" x={CX + CW / 2} y={CENTER_Y + 43} text-anchor="middle">{centerSub[0]}</text>}
    {
      [...above, ...below].map((n) => (
        <g>
          <rect class={boxClass(n.tone)} x={n.x} y={n.y} width={BOX_W} height={BOX_H} rx="8" />
          {n.title.map((line, i) => (
            <text class="dg-label" x={n.x + BOX_W / 2} y={n.y + 20 + i * 15} text-anchor="middle">
              {line}
            </text>
          ))}
          {n.rel.map((line, i) => (
            <text class="dg-sub" x={n.x + BOX_W / 2} y={n.y + 22 + n.title.length * 15 + i * 13} text-anchor="middle">
              {line}
            </text>
          ))}
        </g>
      ))
    }
  </svg>
</DiagramFigure>
