---
/**
 * Two axes, four quadrants: value × effort, power × interest, probability ×
 * impact, Kano. Built at phone width (360). Points are numbered markers; their
 * names are in the HTML list under the drawing, so no label ever collides.
 */
import DiagramFigure from "../DiagramFigure.astro";
import DataTable from "../DataTable.astro";
import { boxClass, wrap, type Tone } from "./util";

interface Axis {
  title: string;
  low: string;
  high: string;
}

interface Quadrant {
  title: string;
  sub?: string;
  tone?: Tone;
}

interface Point {
  label: string;
  /** 0 = low end of the axis, 1 = high end. */
  x: number;
  y: number;
}

interface Props {
  label: string;
  caption: string;
  x: Axis;
  y: Axis;
  /** Top-left, top-right, bottom-left, bottom-right. */
  quadrants: [Quadrant, Quadrant, Quadrant, Quadrant];
  points?: Point[];
}

const { label, caption, x, y, quadrants, points = [] } = Astro.props;

const LEFT = 44;
const TOP = 12;
const SIZE = 300;
const HALF = SIZE / 2;
const cells = [
  { q: quadrants[0], cx: LEFT, cy: TOP },
  { q: quadrants[1], cx: LEFT + HALF, cy: TOP },
  { q: quadrants[2], cx: LEFT, cy: TOP + HALF },
  { q: quadrants[3], cx: LEFT + HALF, cy: TOP + HALF },
].map((cell) => ({ ...cell, title: wrap(cell.q.title, HALF - 20, "label", 2), sub: cell.q.sub ? wrap(cell.q.sub, HALF - 20, "sub", 2) : [] }));
const placed = points.map((point, index) => ({
  ...point,
  n: index + 1,
  px: LEFT + 10 + Math.min(1, Math.max(0, point.x)) * (SIZE - 20),
  py: TOP + 10 + (1 - Math.min(1, Math.max(0, point.y))) * (SIZE - 20),
}));
const quadrantOf = (point: Point) => quadrants[(point.y >= 0.5 ? 0 : 2) + (point.x >= 0.5 ? 1 : 0)].title;
const height = TOP + SIZE + 44;
---

<DiagramFigure label={label} caption={caption}>
  <svg class="dg-narrow" viewBox={`0 0 360 ${height}`} role="img" aria-label={label}>
    <title>{label}</title>
    {
      cells.map((cell) => (
        <>
          <rect class={boxClass(cell.q.tone)} x={cell.cx + 3} y={cell.cy + 3} width={HALF - 6} height={HALF - 6} rx="8" />
          {cell.title.map((line, i) => (
            <text class="dg-label" x={cell.cx + 14} y={cell.cy + 26 + i * 16}>
              {line}
            </text>
          ))}
          {cell.sub.map((line, i) => (
            <text class="dg-sub" x={cell.cx + 14} y={cell.cy + 30 + cell.title.length * 16 + i * 14}>
              {line}
            </text>
          ))}
        </>
      ))
    }

    {/* Axes: arrows from low to high, the end labels in words. */}
    <path class="dg-line" d={`M${LEFT} ${TOP + SIZE + 8} H${LEFT + SIZE}`} />
    <path class="dg-line" d={`M${LEFT + SIZE - 7} ${TOP + SIZE + 3} l7 5 -7 5`} stroke-linejoin="round" />
    <text class="dg-sub" x={LEFT} y={TOP + SIZE + 24}>{x.low}</text>
    <text class="dg-sub" x={LEFT + SIZE} y={TOP + SIZE + 24} text-anchor="end">{x.high}</text>
    <text class="dg-label" x={LEFT + HALF} y={TOP + SIZE + 40} text-anchor="middle">{x.title}</text>

    <path class="dg-line" d={`M${LEFT - 8} ${TOP + SIZE} V${TOP}`} />
    <path class="dg-line" d={`M${LEFT - 13} ${TOP + 7} l5 -7 5 7`} stroke-linejoin="round" />
    <text class="dg-sub" transform={`translate(${LEFT - 16} ${TOP + SIZE}) rotate(-90)`}>{y.low}</text>
    <text class="dg-sub" transform={`translate(${LEFT - 16} ${TOP}) rotate(-90)`} text-anchor="end">{y.high}</text>
    <text class="dg-label" transform={`translate(${LEFT - 30} ${TOP + HALF}) rotate(-90)`} text-anchor="middle">{y.title}</text>

    {
      placed.map((point) => (
        <>
          <circle class="dg-fill-action" cx={point.px} cy={point.py} r="11" />
          <text class="dg-on-action" x={point.px} y={point.py + 4.5} text-anchor="middle">
            {point.n}
          </text>
        </>
      ))
    }
  </svg>
  {
    placed.length > 0 && (
      <ol class="dg-legend">
        {placed.map((point) => (
          <li>{point.label}</li>
        ))}
      </ol>
    )
  }
  {
    placed.length > 0 && (
      <DataTable
        slot="data"
        caption={label}
        head={["Öğe", x.title, y.title, "Kare"]}
        rows={placed.map((point) => [
          point.label,
          point.x >= 0.5 ? x.high : x.low,
          point.y >= 0.5 ? y.high : y.low,
          quadrantOf(point),
        ])}
      />
    )
  }
</DiagramFigure>
