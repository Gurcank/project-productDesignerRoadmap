---
/**
 * Main navigation from 64rem (ADR-016): a glass column of icons at the left
 * edge that widens into labels on hover or keyboard focus. Plain HTML and CSS —
 * no script. Shares its list with the bottom bar (~/data/nav).
 *
 * Closed, the icons alone say where you can go, and the current page's icon sits
 * in a lit capsule. Labels are always in the accessibility tree.
 */
import type { NavItem } from "~/data/nav";

interface Props {
  items: NavItem[];
  section?: string;
}

const { items, section } = Astro.props;
---

<nav class="site-rail" aria-label="Ana menü">
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={section === item.id ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d={item.icon} />
            </svg>
            <span class="site-rail__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-rail {
      position: fixed;
      inset-inline-start: var(--spacing-4);
      inset-block-start: 50%;
      z-index: var(--z-sticky);
      display: block;
      translate: 0 -50%;
      padding: var(--spacing-2);
      border: 1px solid var(--c-border-strong);
      border-radius: 1.75rem;
      background-color: var(--c-glass-strong);
      box-shadow: var(--elev-2);
      -webkit-backdrop-filter: blur(16px) saturate(1.3);
      backdrop-filter: blur(16px) saturate(1.3);
    }

    .site-rail ul {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-1);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-rail a {
      display: flex;
      align-items: center;
      gap: var(--spacing-3);
      min-block-size: 44px;
      padding-inline: 11px;
      border-radius: var(--radius-full);
      color: var(--c-text-muted);
      text-decoration: none;
      transition:
        color var(--dur) var(--e-out),
        background-color var(--dur) var(--e-out);
    }

    .site-rail a:hover,
    .site-rail a:focus-visible {
      color: var(--c-text);
      background-color: color-mix(in oklab, var(--c-text) 8%, transparent);
    }

    .site-rail a[aria-current="page"] {
      color: var(--c-text);
      background-color: color-mix(in oklab, var(--c-action) 16%, transparent);
    }

    .site-rail a[aria-current="page"] svg {
      stroke: var(--c-action);
    }

    .site-rail svg {
      flex: none;
      inline-size: 22px;
      block-size: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* Labels: collapsed to zero width, opened together on hover/focus. */
    .site-rail__label {
      max-inline-size: 0;
      overflow: hidden;
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: 500;
      white-space: nowrap;
      opacity: 0;
      transition:
        max-inline-size var(--dur-slow) var(--e-out),
        opacity var(--dur) var(--e-out);
    }

    .site-rail:hover .site-rail__label,
    .site-rail:focus-within .site-rail__label {
      max-inline-size: 8rem;
      padding-inline-end: var(--spacing-2);
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .site-rail__label {
        transition: opacity var(--dur) linear;
      }
    }
  }
</style>
