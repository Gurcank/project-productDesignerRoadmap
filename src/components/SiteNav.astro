---
/**
 * Main navigation on wide screens (ADR-016): a column of short lines at the
 * left edge that opens into labels on hover or keyboard focus. The look is the
 * Framer "Table of Content" component's; the build is plain HTML and CSS —
 * the project ships no React (ADR-003), and nothing here needs a script.
 *
 * Closed, the only things shown are the lines, and the current page's line is
 * longer and in the action colour, so the menu still says where you are
 * without opening. Labels are always in the accessibility tree.
 */
interface Props {
  items: readonly { href: string; label: string; id: string }[];
  section?: string;
}

const { items, section } = Astro.props;
---

<nav class="site-rail" aria-label="Ana menü">
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={section === item.id ? "page" : undefined}>
            <span class="site-rail__line" aria-hidden="true"></span>
            <span class="site-rail__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-rail {
    display: none;
  }

  @media (min-width: 64rem) {
    .site-rail {
      --rail-spring: linear(0, 0.42 9%, 0.86 20%, 1.04 32%, 1.02 44%, 1 60%, 1);
      --rail-time: 400ms;

      position: fixed;
      inset-inline-start: var(--spacing-4);
      inset-block-start: 50%;
      z-index: var(--z-sticky);
      display: block;
      transform: translateY(-50%);
    }

    /* The panel only exists while open: it is what keeps a label legible when it
       lands on top of page content. */
    .site-rail::before {
      content: "";
      position: absolute;
      inset: calc(var(--spacing-3) * -1) calc(var(--spacing-4) * -1) calc(var(--spacing-3) * -1) calc(var(--spacing-3) * -1);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-lg);
      background-color: var(--c-surface-overlay);
      opacity: 0;
      transition: opacity 180ms ease-out;
      pointer-events: none;
    }

    .site-rail:hover::before,
    .site-rail:focus-within::before {
      opacity: 1;
    }

    .site-rail ul {
      position: relative;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .site-rail a {
      display: flex;
      align-items: center;
      gap: var(--spacing-2);
      min-height: 24px;
      color: var(--c-text-secondary);
      text-decoration: none;
      transition: min-height var(--rail-time) var(--rail-spring);
    }

    .site-rail:hover a,
    .site-rail:focus-within a {
      min-height: 32px;
    }

    .site-rail__line {
      flex: none;
      inline-size: 12px;
      block-size: 3px;
      border-radius: 2px;
      background-color: var(--c-route-line);
      transition:
        inline-size var(--rail-time) var(--rail-spring),
        background-color 120ms ease-out;
    }

    .site-rail a[aria-current="page"] .site-rail__line {
      inline-size: 24px;
      background-color: var(--c-action);
    }

    .site-rail__label {
      font-size: var(--text-xs);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(-6px);
      transition:
        opacity 180ms ease-out,
        transform var(--rail-time) var(--rail-spring),
        color 120ms ease-out;
    }

    /* Open: every label shows, the one under the pointer or focus lights up,
       and its line stretches while its neighbours half-stretch — the Framer
       component's "magnify" feel without a script. */
    .site-rail:hover .site-rail__label,
    .site-rail:focus-within .site-rail__label {
      opacity: 1;
      transform: none;
    }

    .site-rail:hover .site-rail__line,
    .site-rail:focus-within .site-rail__line {
      inline-size: 12px;
    }

    .site-rail a[aria-current="page"] .site-rail__label {
      color: var(--c-text);
    }

    .site-rail a:hover,
    .site-rail a:focus-visible {
      color: var(--c-text);
    }

    .site-rail a:hover .site-rail__line,
    .site-rail a:focus-visible .site-rail__line {
      inline-size: 24px;
      background-color: var(--c-text-secondary);
    }

    .site-rail li:has(+ li > a:hover) .site-rail__line,
    .site-rail li:has(+ li > a:focus-visible) .site-rail__line,
    .site-rail li:hover + li .site-rail__line,
    .site-rail li:has(> a:focus-visible) + li .site-rail__line {
      inline-size: 18px;
    }

    .site-rail a[aria-current="page"]:hover .site-rail__line,
    .site-rail a[aria-current="page"]:focus-visible .site-rail__line {
      background-color: var(--c-action);
    }

    /* Hover is information, not decoration: without motion the lines still
       change length, they just do not travel there. */
    @media (prefers-reduced-motion: reduce) {
      .site-rail a,
      .site-rail__line,
      .site-rail__label {
        transition: opacity 120ms linear, background-color 120ms linear;
        transform: none;
      }
    }
  }
</style>
