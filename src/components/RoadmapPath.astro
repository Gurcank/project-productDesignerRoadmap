---
/**
 * The home page's signature surface at 64rem and up (SPEC §5, ADR-014).
 *
 * ~/components/RoadmapRoute.astro (below 64rem) reads as a document: cards
 * stacked in bands, wrapping like text. A phone screen is a column, so a
 * column is what it draws. A desktop screen is not a column — there is width
 * to use — and the same stacked-card layout just left most of it empty. This
 * component spends that width on an actual map: a single winding line of
 * circular stations, snaking left-to-right then right-to-left down the page,
 * so the route reads as one continuous path instead of four independent grids
 * wrapped in accordions.
 *
 * Same data, same order, same progress store as RoadmapRoute — only the
 * arrangement differs. Both stay mounted on every load; ~/pages/index.astro
 * toggles which one is visible by width, so switching between them costs a
 * CSS rule, not a re-render, and a user who resizes the window never sees a
 * gap where neither is showing.
 */
import { AREAS, DURABILITY_LABEL, ROUTE_ORDER, ROUTE_POSITION, categoriesOfArea } from "~/data/categories";

interface Props {
  /** Slugs that actually have imported content; the rest render as inert nodes. */
  publishedSlugs: Set<string>;
  topicIdsByCategory: Record<string, string[]>;
}

const { publishedSlugs, topicIdsByCategory } = Astro.props;

const AREA_BY_ID = new Map(AREAS.map((area) => [area.id, area]));

// One tag per area, placed on the first station that belongs to it — not a
// full-width header row, because a header would break the path into segments
// again, which is exactly what this layout exists to avoid.
const areaStartSlugs = new Set<string>();
let lastArea: string | null = null;
for (const category of ROUTE_ORDER) {
  if (category.area !== lastArea) {
    areaStartSlugs.add(category.slug);
    lastArea = category.area;
  }
}

const areaTopicIds = new Map(
  AREAS.map((area) => [
    area.id,
    categoriesOfArea(area.id).flatMap((category) => topicIdsByCategory[category.slug] ?? []),
  ]),
);

/*
 * Fixed row width, not a responsive column count: the turn connector between
 * row N and row N+1 has to land on the station it points at, and that only
 * holds if every screen ≥64rem chunks the route into rows the same way. A
 * `repeat(auto-fill, …)` grid would let the browser decide row membership at
 * runtime and silently break the geometry below.
 */
const ROW_SIZE = 4;
const rows: (typeof ROUTE_ORDER)[] = [];
for (let index = 0; index < ROUTE_ORDER.length; index += ROW_SIZE) {
  rows.push(ROUTE_ORDER.slice(index, index + ROW_SIZE));
}
---

<div class="path" data-roadmap-path>
  {
    rows.map((row, rowIndex) => {
      // Alternating visual direction is what makes the turn connector a
      // straight line instead of a diagonal one: reversing every other row
      // keeps the row's last DOM item and the next row's first DOM item on
      // the same physical edge, so the line between them never has to bend.
      const reversed = rowIndex % 2 === 1;
      const turnEdge = rowIndex % 2 === 0 ? "right" : "left";

      return (
        <>
          <ol class:list={["path__row", { "path__row--reverse": reversed, "path__row--solo": row.length === 1 }]}>
            {row.map((category) => {
              const live = publishedSlugs.has(category.slug);
              const ids = topicIdsByCategory[category.slug] ?? [];
              const durability = DURABILITY_LABEL[category.durability];
              const area = AREA_BY_ID.get(category.area)!;
              const isAreaStart = areaStartSlugs.has(category.slug);
              // A node with no destination is a dead end for keyboard and
              // screen readers, so unpublished categories are not anchors.
              const Tag = live ? "a" : "div";

              return (
                <li class="station">
                  {/* A heading, not a styled span: RoadmapRoute gives each area
                      an <h2> and a screen-reader user on a wide screen loses
                      that document structure for nothing if this one doesn't. */}
                  {isAreaStart && (
                    <h2 class="station__area" data-area-ids={areaTopicIds.get(category.area)!.join(" ")}>
                      {area.title}
                      <span class="station__area-count">
                        <span data-area-done>0</span>/{areaTopicIds.get(category.area)!.length}
                      </span>
                    </h2>
                  )}

                  <Tag
                    class:list={["station__body", { "station__body--pending": !live }]}
                    href={live ? `/${category.slug}/` : undefined}
                    data-node={category.slug}
                    data-topic-ids={ids.join(" ")}
                  >
                    <span class="station__ring-wrap" aria-hidden="true">
                      {live && (
                        <svg class="ring" viewBox="0 0 64 64" data-ring>
                          <circle class="ring__track" cx="32" cy="32" r="28" />
                          {/* pathLength normalises the circumference to 100, so the
                              offset is simply "100 minus percent done". */}
                          <circle
                            class="ring__fill"
                            cx="32"
                            cy="32"
                            r="28"
                            pathLength="100"
                            stroke-dasharray="100"
                            stroke-dashoffset="100"
                          />
                        </svg>
                      )}
                      <span class="station__step">{ROUTE_POSITION.get(category.slug)}</span>
                    </span>

                    <span class="station__title">{category.nodeTitle}</span>

                    <span class="station__meta">
                      {live ? (
                        <>
                          <span data-node-count>0/{ids.length}</span>
                          <span class="station__dot" title={durability.help}>
                            {durability.dot}
                          </span>
                        </>
                      ) : (
                        <span class="station__pending">hazırlanıyor</span>
                      )}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ol>

          {rowIndex < rows.length - 1 && <div class:list={["path__turn", `path__turn--${turnEdge}`]} aria-hidden="true" />}
        </>
      );
    })
  }
</div>

{
  /*
   * No script here on purpose: RoadmapRoute.astro's own script block already queries
   * `[data-topic-ids]` and `[data-area-ids]` across the whole document, not
   * scoped to its own markup. Both components share those attribute names, so
   * one subscription drives whichever of the two is visible — adding a second
   * copy here would double-run the same update on every progress change.
   */
}

<style>
  .path {
    --col-w: 10.5rem;
    --station-d: 4.5rem;
    --turn-h: var(--spacing-12);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .path__row {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path__row--solo {
    justify-content: flex-start;
  }

  .path__row--reverse {
    flex-direction: row-reverse;
  }

  /* The horizontal leg of the path: one dashed line from the first station's
     centre to the last station's centre, sitting behind the circles. Direction
     doesn't matter here — the line is symmetric, so row-reverse never affects
     it — only the turn connectors below care which edge is which. */
  .path__row:not(.path__row--solo)::before {
    content: "";
    position: absolute;
    inset-inline: calc(var(--col-w) / 2);
    inset-block-start: calc(var(--station-d) / 2 - 1px);
    block-size: 2px;
    background-image: repeating-linear-gradient(to right, var(--c-route-line) 0 6px, transparent 6px 12px);
  }

  /* The turn between two rows. Both ends land on the same physical edge
     because the rows alternate direction (see the frontmatter comment), so
     this is a straight vertical segment, never a diagonal or a curve. */
  .path__turn {
    position: relative;
    block-size: var(--turn-h);
  }

  .path__turn::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inline-size: 2px;
    background-image: repeating-linear-gradient(to bottom, var(--c-route-line) 0 6px, transparent 6px 12px);
  }

  .path__turn--right::before {
    inset-inline-end: calc(var(--col-w) / 2 - 1px);
  }

  .path__turn--left::before {
    inset-inline-start: calc(var(--col-w) / 2 - 1px);
  }

  /* Arrowhead at the bottom of the turn — a triangle drawn with borders, same
     technique RoadmapRoute uses for its own connectors, so the two read as one
     visual language even though the layouts differ. */
  .path__turn::after {
    content: "";
    position: absolute;
    inset-block-end: -1px;
    inline-size: 0;
    block-size: 0;
    border: 5px solid transparent;
    border-block-start-color: var(--c-route-line);
    border-block-end-width: 0;
  }

  .path__turn--right::after {
    inset-inline-end: calc(var(--col-w) / 2 - 6px);
  }

  .path__turn--left::after {
    inset-inline-start: calc(var(--col-w) / 2 - 6px);
  }

  /* -------------------------------------------------------------- station */
  .station {
    position: relative;
    flex: 0 0 var(--col-w);
    /* Rows past the first can grow tall from an area tag — align every
       station's circle to the same baseline regardless. */
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Pinned above whichever station starts a new area, not a full-width header:
     a header row would cut the path into segments again. */
  .station__area {
    position: absolute;
    inset-block-end: 100%;
    margin: 0 0 var(--spacing-2);
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    max-inline-size: calc(var(--col-w) * 1.6);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-secondary);
    white-space: nowrap;
  }

  .station__area-count {
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .station__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    inline-size: var(--col-w);
    padding-block-start: var(--spacing-6);
    color: var(--c-text);
    text-decoration: none;
    text-align: center;
  }

  .station__ring-wrap {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--station-d);
    block-size: var(--station-d);
    border-radius: var(--radius-full);
    background-color: var(--c-surface-raised);
    border: 1.5px solid var(--c-border);
    transition:
      border-color var(--dur-fast) var(--e-out),
      background-color var(--dur-fast) var(--e-out),
      translate var(--dur-fast) var(--e-out);
  }

  a.station__body:hover .station__ring-wrap {
    translate: 0 -2px;
    border-color: var(--c-border-strong);
    background-color: var(--c-surface-overlay);
  }

  .station__body--pending .station__ring-wrap {
    border-style: dashed;
    background-color: transparent;
  }

  .ring {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    rotate: -90deg;
  }

  /* An empty ring is only its track, so it answers to the 3:1 non-text rule
     the same way an empty checkbox does. */
  .ring__track {
    fill: none;
    stroke: var(--c-control-border);
    stroke-width: 3;
  }

  .ring__fill {
    fill: none;
    stroke: var(--c-progress);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dashoffset var(--dur) var(--e-out);
  }

  .station__step {
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .is-complete .station__step {
    color: var(--c-progress-text);
  }

  .station__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    max-inline-size: calc(var(--col-w) - var(--spacing-2));
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  .station__body--pending .station__title {
    color: var(--c-text-secondary);
    font-weight: 400;
  }

  .station__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .station__pending {
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  .is-started .station__ring-wrap,
  .is-complete .station__ring-wrap {
    border-color: var(--c-progress);
  }

  @media (prefers-reduced-motion: reduce) {
    a.station__body:hover .station__ring-wrap {
      translate: none;
    }
  }

  /* Rows carry an area tag on their first station, which needs headroom above
     the row — but only the very first row's tag would otherwise collide with
     whatever sits above the path on the page. */
  .path__row:first-child {
    margin-block-start: var(--spacing-6);
  }
</style>
