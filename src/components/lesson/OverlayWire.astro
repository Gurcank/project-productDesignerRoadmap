---
import DiagramFigure from "../diagrams/DiagramFigure.astro";
---

<DiagramFigure
  label="Dört katman türü: modal, drawer, popover, tooltip"
  caption="Hepsi sayfanın üstünde durur ama işleri farklıdır: modal arkayı kilitler, drawer bağlamı korur, popover etkileşimli içerik taşır, tooltip yalnızca kısa bir ad söyler."
>
  <svg class="dg-narrow" viewBox="0 0 360 330" role="img" aria-label="Modal ortada, drawer yanda, popover bir butonun altında, tooltip bir ikonun üstünde">
    <title>Modal, drawer, popover, tooltip</title>

    <rect class="dg-box" x="8" y="8" width="170" height="146" rx="8"></rect>
    <rect class="dg-box" x="8" y="8" width="170" height="146" rx="8" opacity="0.5"></rect>
    <rect class="dg-box dg-box--accent" x="38" y="42" width="110" height="78" rx="8"></rect>
    <text class="dg-label" x="93" y="70" text-anchor="middle">Modal</text>
    <text class="dg-sub" x="93" y="90" text-anchor="middle">arka kilitli</text>
    <text class="dg-sub" x="93" y="106" text-anchor="middle">ortada</text>

    <rect class="dg-box" x="190" y="8" width="162" height="146" rx="8"></rect>
    <rect class="dg-box dg-box--accent" x="266" y="8" width="86" height="146" rx="8"></rect>
    <text class="dg-label" x="309" y="70" text-anchor="middle">Drawer</text>
    <text class="dg-sub" x="309" y="90" text-anchor="middle">yandan, bağlam</text>
    <text class="dg-sub" x="309" y="106" text-anchor="middle">görünür</text>
    <rect class="dg-box" x="202" y="30" width="52" height="10" rx="3"></rect>
    <rect class="dg-box" x="202" y="48" width="52" height="10" rx="3"></rect>
    <rect class="dg-box" x="202" y="66" width="52" height="10" rx="3"></rect>

    <rect class="dg-box" x="8" y="166" width="170" height="156" rx="8"></rect>
    <rect class="dg-box" x="24" y="182" width="76" height="26" rx="6"></rect>
    <text class="dg-sub" x="62" y="199" text-anchor="middle">Ayarlar ▾</text>
    <rect class="dg-box dg-box--accent" x="24" y="216" width="136" height="92" rx="8"></rect>
    <text class="dg-label" x="92" y="240" text-anchor="middle">Popover</text>
    <text class="dg-sub" x="92" y="260" text-anchor="middle">tıklamayla açılır,</text>
    <text class="dg-sub" x="92" y="276" text-anchor="middle">link/form taşır</text>

    <rect class="dg-box" x="190" y="166" width="162" height="156" rx="8"></rect>
    <rect class="dg-box dg-box--progress" x="224" y="190" width="94" height="26" rx="6"></rect>
    <text class="dg-sub" x="271" y="207" text-anchor="middle">Dışa aktar</text>
    <rect class="dg-box" x="252" y="228" width="38" height="38" rx="8"></rect>
    <path class="dg-line" d="M262 252 L271 242 L280 252 M271 242 V258"></path>
    <text class="dg-label" x="271" y="288" text-anchor="middle">Tooltip</text>
    <text class="dg-sub" x="271" y="306" text-anchor="middle">kısa ad, tıklanmaz</text>
  </svg>
</DiagramFigure>
