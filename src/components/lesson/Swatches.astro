---
/**
 * A colour ramp as labelled swatches. Each swatch carries its name and value as
 * text: a ramp that only works if you can see colour is not a ramp worth showing.
 * Colours are lesson content, passed in as data.
 */
interface Swatch {
  name: string;
  color: string;
}

interface Props {
  swatches: Swatch[];
}

const { swatches } = Astro.props;
---

<ul class="swatches">
  {
    swatches.map((swatch) => (
      <li class="swatches__item">
        <span class="swatches__chip" style={`background-color:${swatch.color}`} aria-hidden="true"></span>
        <span class="swatches__name">{swatch.name}</span>
        <span class="swatches__value">{swatch.color}</span>
      </li>
    ))
  }
</ul>

<style>
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: var(--spacing-3);
    margin: var(--spacing-6) 0;
    padding: 0;
    list-style: none;
  }

  .swatches__item {
    display: grid;
    gap: var(--spacing-1);
    font-size: var(--text-xs);
  }

  .swatches__chip {
    block-size: 2.5rem;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-sm);
  }

  .swatches__name {
    font-weight: 600;
    color: var(--c-text);
  }

  .swatches__value {
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
