---
/**
 * A link from a lesson to a template in Araçlar: "this is the document the
 * lesson just described, ready to use". An unknown slug breaks the build, so a
 * lesson can never point at a template that does not exist.
 */
import { getTemplates } from "~/lib/templates";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const template = (await getTemplates()).find((item) => item.slug === slug);
if (!template) throw new Error(`<Tool slug="${slug}">: src/tools/sablonlar/${slug} yok`);
const { title, summary, kind } = template.entry.data;
---

<aside class="tool-link" data-pagefind-ignore>
  <p class="tool-link__kind">Şablon · {kind === "tablo" ? "tablo, CSV" : "belge, Markdown"}</p>
  <p class="tool-link__title"><a href={`/araclar/${slug}/`}>{title}</a></p>
  <p class="tool-link__summary">{summary} Doldurulmuş örneği ve boş hâli Araçlar'da.</p>
</aside>

<style is:global>
  .tool-link {
    position: relative;
    margin-block: var(--spacing-6);
    padding: var(--spacing-4) var(--spacing-6);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-lg);
  }

  .tool-link:hover {
    border-color: var(--c-action);
    border-style: solid;
  }

  .tool-link:has(a:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .tool-link__kind {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-action);
  }

  .tool-link__title {
    margin-block-start: var(--spacing-1);
    font-weight: 600;
  }

  .tool-link__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  .tool-link__title a:focus-visible {
    outline: none;
  }

  .tool-link__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tool-link__summary {
    margin-block-start: var(--spacing-1);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }
</style>
