---
import DiagramFigure from "../diagrams/DiagramFigure.astro";
---

<DiagramFigure
  label="Kutu modeli: içerik, padding, kenarlık, margin"
  caption="Padding kutunun içinde kalır ve arka plan rengini alır; margin kutunun dışındadır ve almaz. Tıklanabilir alanı padding büyütür."
>
  <svg class="dg-narrow" viewBox="0 0 360 260" role="img" aria-label="İç içe dört katman: margin, border, padding, content">
    <title>Kutu modeli</title>
    <rect class="dg-box" x="8" y="8" width="344" height="244" rx="8" stroke-dasharray="5 4"></rect>
    <text class="dg-sub" x="20" y="28">margin (dış boşluk, renksiz)</text>
    <rect class="dg-box dg-box--accent" x="40" y="42" width="280" height="188" rx="6"></rect>
    <text class="dg-sub" x="52" y="62">border (kenarlık)</text>
    <rect class="dg-box dg-box--progress" x="70" y="76" width="220" height="130" rx="4"></rect>
    <text class="dg-sub" x="82" y="96">padding (iç boşluk, arka plan dolu)</text>
    <rect class="dg-box" x="110" y="118" width="140" height="64" rx="4"></rect>
    <text class="dg-label" x="180" y="154" text-anchor="middle">content</text>
  </svg>
</DiagramFigure>
