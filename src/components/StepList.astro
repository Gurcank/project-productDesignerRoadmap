---
import { getCollection } from "astro:content";
import { topicMinutes, topicHref, topicId, type TopicEntry } from "~/lib/content";
import { TIER_LABEL } from "~/data/roles";
import { getStepTiers, groupStates } from "~/lib/routes";
import Checkbox from "~/components/ui/Checkbox.astro";

interface Props {
  topics: TopicEntry[];
  /** Progress id of the topic currently open, if any. */
  activeId?: string;
  categorySlug: string;
  categoryTitle: string;
  quizHref?: string;
  /** On a lesson page the heading is the category, linking back up to it. */
  titleHref?: string;
  /** Text of that heading link; defaults to the category title. */
  titleLabel?: string;
  /** The thin progress bar under the heading; off where the page shows its own. */
  meter?: boolean;
}

const { topics, activeId, categorySlug, categoryTitle, quizHref, titleHref, titleLabel, meter = true } = Astro.props;

// A lesson states its own reading time; the step file can only estimate one.
const lessonMinutes = new Map((await getCollection("lessons")).map((entry) => [entry.id, entry.data.minutes]));
const minutesOf = (topic: TopicEntry) => lessonMinutes.get(topicId(topic)) ?? topicMinutes(topic);

const stepTiers = await getStepTiers();
/** One label per tier, shared by every role that gives the step that tier. */
const tiersOf = (id: string) =>
  groupStates(
    (stepTiers.get(id) ?? []).map(({ state, tier }) => ({ state, value: tier })),
    (tier) => tier,
  );
/** "product-manager:t scrum-master:i", read by the category page's start button. */
const tierAttr = (id: string) =>
  (stepTiers.get(id) ?? []).map(({ state, tier }) => `${state}:${TIER_LABEL[tier].code}`).join(" ");
---

<nav class="steps" aria-labelledby={`steps-${categorySlug}`} data-steps={categorySlug}>
  <div class="steps__head">
    <h2 id={`steps-${categorySlug}`} class="steps__title">
      {titleHref ? <a href={titleHref}>{titleLabel ?? categoryTitle}</a> : "Adımlar"}
    </h2>
    <p class="steps__count" data-progress-summary={categorySlug}>
      <span data-progress-done>0</span>/<span data-progress-total>{topics.length}</span>
    </p>
  </div>
  {meter && <div class="steps__meter" aria-hidden="true"><span data-steps-meter></span></div>}

  <ol class="steps__list">
    {
      topics.map((topic, index) => {
        const id = topicId(topic);
        return (
          <li class="step" data-step={id} data-tiers={tierAttr(id)}>
            <Checkbox
              class="step__check"
              id={`check-${id}`}
              value={id}
              label={`${topic.data.title} — tamamlandı olarak işaretle`}
              hideLabel
            />
            <a class="step__link" href={topicHref(topic)} aria-current={activeId === id ? "page" : undefined}>
              <span class="step__index" aria-hidden="true">
                {index + 1}
              </span>
              <span class="step__text">
                <span class="step__title">{topic.data.title}</span>
                {tiersOf(id).map((group) => (
                  <span class="step__tier" data-tier={TIER_LABEL[group.value].code} data-for-role={group.states.join(" ")}>
                    <span class="sr-only">Rolün için: </span>
                    {TIER_LABEL[group.value].label}
                  </span>
                ))}
              </span>
              <span class="step__time">{minutesOf(topic)} dk</span>
            </a>
          </li>
        );
      })
    }
  </ol>

  {
    quizHref && (
      <a class="steps__quiz" href={quizHref}>
        Kendini test et
        <span class="steps__quiz-note">{categoryTitle} soruları</span>
      </a>
    )
  }
</nav>

<script>
  import { initProgress, $progress, setDone, summarise } from "~/lib/progress";

  initProgress();

  const container = document.querySelector<HTMLElement>("[data-steps]");
  if (container) {
    const checks = Array.from(container.querySelectorAll<HTMLInputElement>("[data-topic-check]"));
    const ids = checks.map((input) => input.dataset.topicCheck!).filter(Boolean);
    const doneEl = container.querySelector<HTMLElement>("[data-progress-done]");
    const meter = container.querySelector<HTMLElement>("[data-steps-meter]");

    const render = () => {
      const progress = $progress.get();
      for (const input of checks) {
        const id = input.dataset.topicCheck!;
        const done = progress.topics[id]?.done === true;
        input.checked = done;
        input.closest(".step")?.classList.toggle("is-done", done);
      }
      const summary = summarise(ids, progress);
      if (doneEl) doneEl.textContent = String(summary.done);
      if (meter) meter.style.inlineSize = `${summary.percent}%`;
    };

    for (const input of checks) {
      input.addEventListener("change", () => setDone(input.dataset.topicCheck!, input.checked));
    }

    $progress.subscribe(render);
  }
</script>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    border: 1px solid var(--c-border);
    border-radius: 1.25rem;
    background-color: var(--c-glass-strong);
  }

  .steps__meter {
    block-size: 4px;
    margin-block-end: var(--spacing-1);
    border-radius: var(--radius-full);
    background-color: var(--c-surface-sunken);
    overflow: hidden;
  }

  .steps__meter span {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background-color: var(--c-progress);
    transition: inline-size var(--dur-slow) var(--e-out);
  }

  .steps__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-3);
  }

  .steps__title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--c-text);
  }

  /* Back up to the category: a standalone link, so a 24px box (SC 2.5.8). */
  .steps__title a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    min-height: 24px;
    color: var(--c-text);
    text-decoration: none;
  }

  .steps__title a::before {
    content: "←";
    color: var(--c-action);
  }

  .steps__title a:hover {
    color: var(--c-action-hover);
  }

  .steps__count {
    font-size: var(--text-xs);
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .steps__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-px);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-1);
  }

  /* The tick is its own 40px target next to the link, not inside it. */
  .step__check {
    flex: 0 0 auto;
  }

  .step__link {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    flex: 1 1 auto;
    min-height: 40px;
    padding: var(--spacing-2) var(--spacing-2);
    border-radius: var(--radius-md);
    color: var(--c-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .step__link:hover {
    background-color: color-mix(in oklab, var(--c-text) 6%, transparent);
    color: var(--c-text);
  }

  .step__link[aria-current="page"] {
    background-color: color-mix(in oklab, var(--c-action) 14%, transparent);
    color: var(--c-text);
    font-weight: 600;
    box-shadow: inset 3px 0 0 var(--c-action);
  }

  .step__index {
    flex: 0 0 auto;
    inline-size: 1.4em;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .step__text {
    flex: 1 1 auto;
  }

  /* Reading time earns its place by making the commitment legible before the
     click: a 3 dk step and a 15 dk step are different decisions. */
  .step__time {
    flex: 0 0 auto;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  /* The step's tier on the chosen route, in words. Fill style is the second
     cue: solid for temel, outline for önerilen, dashed for isteğe bağlı. */
  .step__tier {
    display: table;
    margin-block-start: var(--spacing-1);
    padding: 0 var(--spacing-2);
    border: 1px solid var(--c-text-secondary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-text);
  }

  .step__tier[data-tier="t"] {
    border-color: var(--c-text);
    background-color: var(--c-text);
    color: var(--c-surface);
  }

  .step__tier[data-tier="i"] {
    border-style: dashed;
    color: var(--c-text-secondary);
  }

  /* Completion is never colour-only: the tick plus a muted label carries it. */
  .step.is-done .step__text {
    color: var(--c-text-muted);
  }

  .steps__quiz {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-px);
    margin-block-start: var(--spacing-3);
    padding: var(--spacing-3);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-md);
    color: var(--c-text);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .steps__quiz:hover {
    border-style: solid;
    border-color: var(--c-action);
  }

  .steps__quiz-note {
    color: var(--c-text-muted);
    font-size: var(--text-xs);
  }
</style>
