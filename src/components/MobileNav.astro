---
/**
 * Thumb-reachable navigation below 64rem (phones and tablets): a floating glass
 * pill at the bottom, where a one-handed thumb already is. From 64rem the left
 * rail (SiteNav) takes over — the two share one list (~/data/nav).
 */
import type { NavItem } from "~/data/nav";

interface Props {
  items: NavItem[];
  section?: string;
}

const { items, section } = Astro.props;
---

<nav class="mobile-nav" aria-label="Ana menü">
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={section === item.id ? "page" : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={item.icon} />
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .mobile-nav {
    position: fixed;
    inset-inline: var(--spacing-3);
    inset-block-end: calc(var(--spacing-3) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-sticky);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    max-inline-size: 28rem;
    margin-inline: auto;
    padding: var(--spacing-1);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    background-color: var(--c-glass-strong);
    box-shadow: var(--elev-2);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
  }

  .mobile-nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    border-radius: var(--radius-full);
    color: var(--c-text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    transition:
      color var(--dur) var(--e-out),
      background-color var(--dur) var(--e-out);
  }

  .mobile-nav a:hover {
    color: var(--c-text);
  }

  /* Current page: a lit capsule behind the icon plus the label in full colour —
     carried by shape and weight, not colour alone. */
  .mobile-nav a[aria-current="page"] {
    color: var(--c-text);
    font-weight: 600;
    background-color: color-mix(in oklab, var(--c-action) 16%, transparent);
  }

  .mobile-nav a[aria-current="page"] svg {
    stroke: var(--c-action);
  }

  .mobile-nav svg {
    inline-size: 22px;
    block-size: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 64rem) {
    .mobile-nav {
      display: none;
    }
  }
</style>
