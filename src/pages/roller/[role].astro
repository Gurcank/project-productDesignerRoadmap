---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import RoleEmblem from "~/components/RoleEmblem.astro";
import { CATEGORY_BY_SLUG } from "~/data/categories";
import { ROLE_IDS, ROLE_LABEL, type RoleId } from "~/data/role-ids";
import { ROLE_BY_ID, TIER_LABEL } from "~/data/roles";
import { formatDuration, getPublishedCategories, topicId, topicMinutes } from "~/lib/content";
import { getRoute } from "~/lib/routes";

export function getStaticPaths() {
  return ROLE_IDS.map((role) => ({ params: { role } }));
}

const id = Astro.params.role as RoleId;
const label = ROLE_LABEL[id];
const definition = ROLE_BY_ID.get(id)!;
const entry = (await getCollection("roles")).find((page) => page.id === id);
if (!entry) throw new Error(`src/roles/${id}.mdx yok`);
const { Content } = await render(entry);
const page = entry.data;

// The route as a list: what the map draws, readable without the map.
const route = await getRoute(id);
const lessons = new Map((await getCollection("lessons")).map((lesson) => [lesson.id, lesson.data.minutes]));
const topics = new Map(
  (await getPublishedCategories()).flatMap(({ topics: list }) => list.map((topic) => [topicId(topic), topic] as const)),
);
const minutesOf = (stepId: string) => {
  const topic = topics.get(stepId);
  return lessons.get(stepId) ?? (topic ? topicMinutes(topic) : 0);
};
const stops = route.stops.map((stop) => {
  const core = stop.steps.filter((step) => step.tier !== "istege-bagli");
  return {
    ...stop,
    title: CATEGORY_BY_SLUG.get(stop.category)!.title,
    coreCount: core.length,
    optionalCount: stop.steps.length - core.length,
    minutes: stop.steps.reduce((sum, step) => sum + minutesOf(step.id), 0),
  };
});
const coreMinutes = route.steps.filter((step) => step.tier !== "istege-bagli").reduce((sum, step) => sum + minutesOf(step.id), 0);
const coreSteps = route.steps.filter((step) => step.tier !== "istege-bagli").length;
---

<BaseLayout title={label.name} description={`${label.name} (${label.tr}): ${definition.summary}`} section="roller">
  <article class="role" data-pagefind-body data-pagefind-filter="tur:Rol" data-pagefind-meta="kategori:Roller">
    <p class="role__back"><a href="/roller/">Roller</a></p>

    <header class="role__head">
      <RoleEmblem role={id} size="lg" />
      <div>
        <h1>{label.name}</h1>
        <p class="role__tr">{label.tr}</p>
      </div>
    </header>
    <p class="role__summary">{definition.summary}</p>
    <p class="role__focus">Sorduğu soru: <strong>“{definition.focus}”</strong></p>

    <div class="role__choose" data-role-choose={id} data-pagefind-ignore>
      <button type="button" class="role__button" data-for-role={[...ROLE_IDS.filter((other) => other !== id), "all", "none"].join(" ")}>
        Bu yolu seç
      </button>
      <p class="role__current" data-for-role={id}>Şu an bu yoldasın. <a href="/">Haritaya dön</a></p>
    </div>

    <div class="duties">
      <section>
        <h2>Neyden hesap verir?</h2>
        <ul>{page.accountable.map((item) => <li>{item}</li>)}</ul>
      </section>
      {
        page.contributes.length > 0 && (
          <section>
            <h2>Neye katkı verir?</h2>
            <ul>{page.contributes.map((item) => <li>{item}</li>)}</ul>
          </section>
        )
      }
      {
        page.notOwner.length > 0 && (
          <section>
            <h2>Neye karar vermez?</h2>
            <ul>{page.notOwner.map((item) => <li>{item}</li>)}</ul>
          </section>
        )
      }
    </div>

    <section class="role__block" aria-labelledby="ciktilar">
      <h2 id="ciktilar">Tipik çıktıları</h2>
      <ul class="chips">{page.artifacts.map((item) => <li>{item}</li>)}</ul>
    </section>

    <div class="prose role__body">
      <Content />
    </div>

    {
      page.neighbours.length > 0 && (
        <section class="role__block" aria-labelledby="komsular">
          <h2 id="komsular">Komşu rollerden farkı</h2>
          <dl class="neighbours">
            {page.neighbours.map((neighbour) => (
              <div>
                <dt>
                  <a href={`/roller/${neighbour.role}/`}>{ROLE_LABEL[neighbour.role as RoleId]?.name ?? neighbour.role}</a>
                </dt>
                <dd>{neighbour.difference}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="role__block" id="yol" aria-labelledby="yol-baslik">
      <h2 id="yol-baslik">Yolun</h2>
      <p class="role__hint">
        {stops.length} durak · temel ve önerilen {coreSteps} ders, yaklaşık {formatDuration(coreMinutes)}. Haritada gördüğün
        çizginin sırası budur.
      </p>
      <ol class="route">
        {
          stops.map((stop) => (
            <li class="route__stop">
              <span class="route__tier" data-tier={TIER_LABEL[stop.tier].code}>
                {TIER_LABEL[stop.tier].label}
              </span>
              <span class="route__name">
                {stop.published ? <a href={`/${stop.category}/`}>{stop.title}</a> : stop.title}
              </span>
              <span class="route__meta">
                {stop.published
                  ? `${stop.coreCount} ders${stop.optionalCount ? ` + ${stop.optionalCount} isteğe bağlı` : ""} · ${formatDuration(stop.minutes)}`
                  : "hazırlanıyor"}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <aside class="sources" aria-labelledby="kaynaklar">
      <h2 id="kaynaklar" class="sources__title">Kaynaklar</h2>
      <ul>
        {
          page.sources.map((source) => (
            <li>
              <a href={source.url} rel="noreferrer">
                {source.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="sources__checked">Son kontrol: {new Date(page.checked).toLocaleDateString("tr-TR", { dateStyle: "long" })}</p>
    </aside>
  </article>
</BaseLayout>

<script>
  import { initRole, setRole } from "~/lib/role";
  import { isRoleState } from "~/data/role-ids";

  initRole();

  const box = document.querySelector<HTMLElement>("[data-role-choose]");
  box?.querySelector("button")?.addEventListener("click", () => {
    const role = box.dataset.roleChoose;
    if (!isRoleState(role)) return;
    setRole(role);
    window.location.href = "/";
  });
</script>

<style>
  .role {
    max-width: 46rem;
    margin-inline: auto;
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-24);
  }

  .role__back a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-1);
    min-height: 24px;
    color: var(--c-action);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .role__back a::before {
    content: "←";
  }

  .role__head {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
    margin-block-start: var(--spacing-6);
  }

  .role__head h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
  }

  .role__tr {
    color: var(--c-text-secondary);
  }

  .role__summary {
    margin-block-start: var(--spacing-6);
    font-size: var(--text-lg);
    color: var(--c-text);
  }

  .role__focus {
    margin-block-start: var(--spacing-2);
    color: var(--c-text-secondary);
  }

  .role__focus strong {
    font-style: italic;
    color: var(--c-text);
  }

  .role__choose {
    margin-block-start: var(--spacing-6);
  }

  /* Choosing a role needs script (it is stored); without it the list below still works. */
  :global(html:not([data-js])) .role__choose {
    display: none;
  }

  .role__button {
    min-block-size: 48px;
    padding-inline: var(--spacing-6);
    border: 0;
    border-radius: var(--radius-full);
    background-color: var(--c-action-surface);
    color: var(--c-on-action);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .role__button:hover {
    background-color: var(--c-action-hover);
  }

  .role__current {
    color: var(--c-text-secondary);
  }

  .duties {
    display: grid;
    gap: var(--spacing-4);
    margin-block-start: var(--spacing-12);
  }

  .duties section {
    padding: var(--spacing-4) var(--spacing-6);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-raised);
  }

  .duties h2,
  .role__block h2 {
    font-size: var(--text-lg);
  }

  .duties ul {
    margin-block-start: var(--spacing-2);
    padding-inline-start: var(--spacing-6);
    list-style: disc;
    color: var(--c-text-secondary);
  }

  .duties li + li {
    margin-block-start: var(--spacing-1);
  }

  .role__block {
    margin-block-start: var(--spacing-12);
  }

  .role__hint {
    margin-block: var(--spacing-2) var(--spacing-4);
    color: var(--c-text-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: var(--spacing-1) var(--spacing-3);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--c-text);
  }

  .role__body {
    margin-block-start: var(--spacing-12);
  }

  .neighbours {
    display: grid;
    gap: var(--spacing-3);
    margin: var(--spacing-3) 0 0;
  }

  .neighbours div {
    padding: var(--spacing-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  .neighbours dt a {
    font-weight: 600;
  }

  .neighbours dd {
    margin: var(--spacing-1) 0 0;
    color: var(--c-text-secondary);
  }

  .route {
    display: grid;
    gap: var(--spacing-1);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: stop;
  }

  .route__stop {
    display: grid;
    grid-template-columns: 2rem 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--spacing-1) var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    counter-increment: stop;
  }

  .route__stop::before {
    content: counter(stop);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .route__stop:nth-child(odd) {
    background-color: var(--c-surface-raised);
  }

  .route__tier {
    justify-self: start;
    padding: 0 var(--spacing-2);
    border: 1px solid var(--c-text-secondary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-text);
  }

  .route__tier[data-tier="t"] {
    border-color: var(--c-text);
    background-color: var(--c-text);
    color: var(--c-surface);
  }

  .route__tier[data-tier="i"] {
    border-style: dashed;
    color: var(--c-text-secondary);
  }

  .route__name a {
    color: var(--c-text);
  }

  .route__meta {
    grid-column: 3;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .sources {
    margin-block-start: var(--spacing-16);
    padding: var(--spacing-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-raised);
  }

  .sources__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .sources ul {
    margin-block-start: var(--spacing-2);
    padding-inline-start: var(--spacing-4);
    font-size: var(--text-sm);
  }

  /* Standalone links, so each needs its own 24px of room (SC 2.5.8). */
  .sources li + li {
    margin-block-start: var(--spacing-2);
  }

  .sources__checked {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  @media (max-width: 30rem) {
    .route__stop {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .route__name,
    .route__meta {
      grid-column: 2;
    }
  }
</style>
