---
/**
 * Chapter 20 as a tool: the eleven phases from idea to measured release, each
 * with the material's own text and, under it, the roles the material does not
 * cover (src/authored/tools/akis-rolleri.json) — marked "Materyal dışı" and
 * linked to the lesson that explains each line.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import MaterialBlocks from "~/components/tools/MaterialBlocks.astro";
import data from "~/data/generated/tools/flow-map.json";
import layer from "~/authored/tools/akis-rolleri.json";
import type { FlowMapData } from "~/lib/material-tools";
import { toolSectionAnchor } from "~/lib/section-refs";
import { ROLE_LABEL, type RoleId } from "~/data/role-ids";
import { getPublishedCategories, topicId } from "~/lib/content";

const flow = data as unknown as FlowMapData;
const ROLES: RoleId[] = ["product-owner", "project-manager", "scrum-master", "business-analyst", "ux-researcher"];
type Line = { text: string; lesson: string };
const phases = layer.phases as Record<string, Partial<Record<RoleId, Line>>>;

const titles = new Map(
  (await getPublishedCategories()).flatMap(({ category, topics }) =>
    topics.map((topic) => [topicId(topic), `${category.title} · ${topic.data.title}`] as const),
  ),
);
for (const phase of flow.phases) {
  const lines = phases[phase.number];
  if (!lines) throw new Error(`akis-rolleri.json: ${phase.number} için rol satırı yok`);
  for (const role of ROLES) {
    const line = lines[role];
    if (!line) throw new Error(`akis-rolleri.json: ${phase.number} için ${role} yok`);
    if (!titles.has(line.lesson)) throw new Error(`akis-rolleri.json: "${line.lesson}" diye bir ders yok`);
  }
}
---

<BaseLayout
  title="Proje akış haritası"
  description="Fikirden ölçülen yayına on bir faz: her fazın amacı, çıktısı, kim ne yapar, kritik kararlar ve atlanırsa ne olur."
  section="araclar"
>
  <article class="flow" data-pagefind-body data-pagefind-filter="tur:Akış haritası" data-pagefind-meta="kategori:Araçlar">
    <p class="flow__back"><a href="/araclar/">Araçlar</a></p>
    <header>
      <p class="flow__kind">Materyalden · Bölüm 20</p>
      <h1>Proje akış haritası</h1>
      <p class="flow__lead">
        Bir web projesi baştan sona nasıl ilerler, hangi anda hangi karar verilir? Materyal her fazı tasarımcının ("Sen"),
        PM'in ve geliştiricinin gözünden anlatır. Her fazın altında, materyalde olmayan beş rolün o fazdaki işi ayrıca yazılı.
      </p>
    </header>

    <MaterialBlocks blocks={flow.intro} label="Akış haritası, giriş" />

    <nav class="flow__toc glass" aria-labelledby="fazlar">
      <h2 id="fazlar">Fazlar</h2>
      <ol>
        {flow.phases.map((phase) => (
          <li>
            <a href={`#${toolSectionAnchor(phase.number)}`}>{phase.phase} — {phase.title}</a>
          </li>
        ))}
        <li>
          <a href={`#${toolSectionAnchor(flow.summary.number)}`}>{flow.summary.title}</a>
        </li>
      </ol>
    </nav>

    {
      flow.phases.map((phase) => {
        const anchor = toolSectionAnchor(phase.number);
        const lines = phases[phase.number]!;
        return (
          <section class="phase" id={anchor} aria-labelledby={`${anchor}-baslik`}>
            <h2 id={`${anchor}-baslik`}>
              <span class="phase__number">{phase.phase}</span>
              {phase.title}
            </h2>
            <MaterialBlocks blocks={phase.blocks} label={`${phase.phase}, ${phase.title}`} />
            <aside class="phase__roles" aria-label={`${phase.phase}: diğer roller`}>
              <p class="phase__flag"><span class="flag flag--new">Materyal dışı</span> Diğer roller bu fazda</p>
              <dl>
                {ROLES.map((role) => {
                  const line = lines[role]!;
                  return (
                    <div class="phase__role">
                      <dt>
                        <a href={`/roller/${role}/`}>{ROLE_LABEL[role].name}</a>
                      </dt>
                      <dd>
                        {line.text} <a href={`/${line.lesson}/`} class="phase__lesson">{titles.get(line.lesson)}</a>
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </aside>
          </section>
        );
      })
    }

    <section class="phase" id={toolSectionAnchor(flow.summary.number)} aria-labelledby="ozet-baslik">
      <h2 id="ozet-baslik">{flow.summary.title}</h2>
      <MaterialBlocks blocks={flow.summary.blocks} label={flow.summary.title} />
    </section>

    <aside class="flow__sources" aria-labelledby="kaynaklar">
      <h2 id="kaynaklar">Kaynaklar</h2>
      <p>Faz metinleri materyalin 20. bölümünden birebir alınmıştır. Diğer rollerin satırları için:</p>
      <ul>
        {layer.sources.map((source) => (
          <li>
            <a href={source.url} rel="noreferrer">{source.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  </article>
</BaseLayout>

<style>
  .flow {
    max-width: 52rem;
    margin-inline: auto;
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-24);
  }

  .flow__back a {
    display: inline-flex;
    gap: var(--spacing-1);
    min-height: 24px;
    align-items: center;
    color: var(--c-action);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .flow__back a::before {
    content: "←";
  }

  .flow__kind {
    margin-block-start: var(--spacing-6);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-action);
  }

  .flow h1 {
    margin-block-start: var(--spacing-2);
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
  }

  .flow__lead {
    margin-block: var(--spacing-3) var(--spacing-8);
    font-size: var(--text-lg);
    color: var(--c-text-secondary);
  }

  .flow__toc {
    margin-block: var(--spacing-8);
    padding: var(--spacing-4) var(--spacing-6);
    border-radius: var(--radius-lg);
  }

  .flow__toc h2 {
    font-size: var(--text-lg);
  }

  .flow__toc ol {
    display: grid;
    gap: var(--spacing-1);
    margin-block-start: var(--spacing-2);
    padding-inline-start: var(--spacing-6);
  }

  .flow__toc a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }

  .phase {
    margin-block-start: var(--spacing-12);
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-reading);
    scroll-margin-top: var(--spacing-8);
  }

  .phase h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-2);
    margin-block-end: var(--spacing-4);
    font-size: var(--text-2xl);
  }

  .phase__number {
    color: var(--c-action);
    font-size: var(--text-base);
  }

  .phase__roles {
    margin-block-start: var(--spacing-6);
    padding: var(--spacing-4);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-md);
  }

  .phase__flag {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
    font-weight: 600;
  }

  .phase__roles dl {
    display: grid;
    gap: var(--spacing-3);
    margin: var(--spacing-3) 0 0;
  }

  .phase__role dt a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    font-weight: 600;
  }

  .phase__role dd {
    margin: 0;
    color: var(--c-text-secondary);
  }

  .phase__lesson {
    font-size: var(--text-sm);
  }

  .flow__sources {
    margin-block-start: var(--spacing-12);
    color: var(--c-text-secondary);
  }

  .flow__sources h2 {
    font-size: var(--text-xl);
    color: var(--c-text);
  }

  .flow__sources ul {
    display: grid;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
    padding-inline-start: var(--spacing-6);
    list-style: disc;
  }
</style>
