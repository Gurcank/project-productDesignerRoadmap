---
import BaseLayout from "~/layouts/BaseLayout.astro";
import OfflineDownload from "~/components/OfflineDownload.astro";
import RolePicker from "~/components/RolePicker.astro";
import { getPublishedCategories } from "~/lib/content";

const published = await getPublishedCategories();
const totalTopics = published.reduce((sum, entry) => sum + entry.topics.length, 0);

const SIZES = [
  { id: "sm", label: "Küçük" },
  { id: "md", label: "Normal" },
  { id: "lg", label: "Büyük" },
  { id: "xl", label: "Çok büyük" },
];
---

<BaseLayout title="Ayarlar" description="Görünüm, çevrimdışı kullanım ve ilerleme yedeği." section="ayarlar">
  <div class="settings">
    <header class="settings__head">
      <h1>Ayarlar</h1>
      <p class="settings__lead">İlerlemen yalnızca bu cihazda saklanır. Arada bir yedek al.</p>
    </header>

    <p class="storage-error" role="alert" data-storage-error hidden></p>

    <div class="cards">
      {/* ------------------------------------------------------- progress */}
      <section class="card card--wide glass" aria-labelledby="ilerleme">
        <div class="progress">
          <div class="progress__gauge" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <circle class="progress__track" cx="60" cy="60" r="52" />
              <circle
                class="progress__fill"
                cx="60"
                cy="60"
                r="52"
                pathLength="100"
                stroke-dasharray="100"
                stroke-dashoffset="100"
                data-stat-ring
              />
            </svg>
            <span class="progress__percent"><span data-stat-percent>0</span><small>%</small></span>
          </div>

          <div class="progress__body">
            <h2 id="ilerleme" class="card__title">İlerleme</h2>
            <dl class="stats" data-total={totalTopics}>
              <div>
                <dt>Tamamlanan ders</dt>
                <dd><span data-stat-done>0</span> / {totalTopics}</dd>
              </div>
              <div>
                <dt>İşaretli madde</dt>
                <dd data-stat-checklists>0</dd>
              </div>
              <div>
                <dt>Son güncelleme</dt>
                <dd data-stat-updated>—</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="actions">
          <a class="button button--primary" download="seeyournextstep-ilerleme.json" data-download>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            Yedeği indir
          </a>
          <label class="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V9M7 14l5-5 5 5M5 4h14" /></svg>
            Yedekten yükle
            <input class="sr-only" type="file" accept="application/json,.json" data-import-file />
          </label>
          <button type="button" class="button" data-copy>Kopyala</button>
          <span class="actions__status" role="status" data-copy-status></span>
        </div>
        <p class="actions__status" role="status" data-import-status></p>

        <details class="advanced">
          <summary>Gelişmiş: yedeği metin olarak gör veya yapıştır</summary>
          <label class="field-label" for="export-json">Mevcut yedek</label>
          <textarea id="export-json" class="json" rows="5" readonly data-export></textarea>
          <label class="field-label" for="import-json">Yedek metnini yapıştır</label>
          <textarea id="import-json" class="json" rows="5" placeholder="{ &quot;version&quot;: 1, … }" data-import-text
          ></textarea>
          <div class="actions">
            <button type="button" class="button" data-import>Bu metni içe aktar</button>
          </div>
        </details>
      </section>

      {/* ----------------------------------------------------------- role */}
      <section class="card card--wide glass" aria-labelledby="rol">
        <h2 id="rol" class="card__title">Rolün</h2>
        <RolePicker variant="settings" />
      </section>

      {/* ----------------------------------------------------- appearance */}
      <section class="card glass" aria-labelledby="gorunum">
        <h2 id="gorunum" class="card__title">Görünüm</h2>

        <p class="setting__label" id="yazi-boyutu">Yazı boyutu</p>
        <div class="segmented" role="group" aria-labelledby="yazi-boyutu">
          {
            SIZES.map((size) => (
              <button type="button" data-text-size={size.id} aria-pressed="false">
                {size.label}
              </button>
            ))
          }
        </div>

        <div class="setting__row">
          <div>
            <p class="setting__label" id="yildiz">Yıldız animasyonu</p>
            <p class="setting__hint">Parlayan ve kayan yıldızlar</p>
          </div>
          <button type="button" class="switch" role="switch" aria-checked="true" aria-labelledby="yildiz" data-stars-switch>
            <span class="switch__thumb"></span>
          </button>
        </div>
      </section>

      {/* -------------------------------------------------------- offline */}
      <section class="card glass" aria-labelledby="cevrimdisi">
        <h2 id="cevrimdisi" class="card__title">Çevrimdışı</h2>
        <p class="setting__hint">Tüm dersleri, sözlüğü ve aramayı indir; internet olmadan açılır.</p>
        <div class="offline">
          <OfflineDownload scope="all" label="Tüm siteyi indir" />
        </div>
      </section>

      {/* --------------------------------------------------------- danger */}
      <details class="card card--wide danger">
        <summary class="danger__summary">İlerlemeyi sıfırla</summary>
        <p class="setting__hint">Tüm tikleri ve liste işaretlerini siler. Geri alınamaz — önce yedeği indir.</p>
        <div class="actions">
          <button type="button" class="button button--danger" data-reset>Her şeyi sil</button>
          <span class="actions__status" role="status" data-reset-status></span>
        </div>
      </details>
    </div>
  </div>
</BaseLayout>

<script>
  import { initProgress, $progress, $storageError, reset } from "~/lib/progress";
  import { exportBackup, importBackup } from "~/lib/backup";
  import { $role } from "~/lib/role";

  initProgress();

  const exportArea = document.querySelector<HTMLTextAreaElement>("[data-export]");
  const download = document.querySelector<HTMLAnchorElement>("[data-download]");
  const importText = document.querySelector<HTMLTextAreaElement>("[data-import-text]");
  const importFile = document.querySelector<HTMLInputElement>("[data-import-file]");
  const errorBox = document.querySelector<HTMLElement>("[data-storage-error]");
  const ring = document.querySelector<SVGCircleElement>("[data-stat-ring]");
  const total = Number(document.querySelector<HTMLElement>("[data-total]")?.dataset.total ?? 0);

  const statusOf = (name: string) => document.querySelector<HTMLElement>(`[data-${name}-status]`);
  const set = (name: string, value: string) => {
    const element = document.querySelector<HTMLElement>(`[data-stat-${name}]`);
    if (element) element.textContent = value;
  };

  let objectUrl: string | null = null;

  // The backup carries the role too, so it is rebuilt when either changes.
  const refreshBackup = () => {
    const json = exportBackup();
    if (exportArea) exportArea.value = json;

    if (download) {
      // Revoke the previous blob before replacing it, or every change leaks one.
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(new Blob([json], { type: "application/json" }));
      download.href = objectUrl;
    }
  };
  $role.subscribe(refreshBackup);

  $progress.subscribe((progress) => {
    refreshBackup();

    const done = Object.values(progress.topics).filter((topic) => topic.done).length;
    // "<id>~na" marks an item as not applicable (kontrol-listeleri); it is not a tick.
    const checked = Object.entries(progress.checklists).filter(([id, on]) => on && !id.endsWith("~na")).length;
    const percent = total > 0 ? Math.min(100, Math.round((done / total) * 100)) : 0;

    set("done", String(done));
    set("percent", String(percent));
    set("checklists", String(checked));
    set("updated", progress.updatedAt ? new Date(progress.updatedAt).toLocaleDateString("tr-TR") : "—");
    if (ring) ring.style.strokeDashoffset = String(100 - percent);
  });

  $storageError.subscribe((message) => {
    if (!errorBox) return;
    errorBox.textContent = message ?? "";
    errorBox.hidden = !message;
  });

  document.querySelector("[data-copy]")?.addEventListener("click", async () => {
    const status = statusOf("copy");
    try {
      await navigator.clipboard.writeText(exportArea?.value ?? "");
      if (status) status.textContent = "Kopyalandı.";
    } catch {
      // Clipboard access can be refused; the text is still in "Gelişmiş".
      if (status) status.textContent = "Kopyalanamadı — Gelişmiş bölümünden seçip kopyala.";
    }
  });

  const restore = (text: string, source: string) => {
    const status = statusOf("import");
    if (!confirm("Yedek, bu cihazdaki ilerlemenin yerine geçecek. Devam edilsin mi?")) {
      if (status) status.textContent = "İptal edildi.";
      return;
    }
    const error = importBackup(text);
    if (status) status.textContent = error ?? `${source} geri yüklendi.`;
  };

  // Choosing a file restores it straight away (after one confirmation).
  importFile?.addEventListener("change", async () => {
    const file = importFile.files?.[0];
    if (!file) return;
    restore(await file.text(), file.name);
    importFile.value = "";
  });

  document.querySelector("[data-import]")?.addEventListener("click", () => {
    const text = importText?.value.trim();
    const status = statusOf("import");
    if (!text) {
      if (status) status.textContent = "Önce bir yedek metni yapıştır.";
      return;
    }
    restore(text, "Yedek");
  });

  // Reading size: the same key the inline script in BaseLayout reads before first paint.
  const sizeButtons = document.querySelectorAll<HTMLButtonElement>("[data-text-size]");
  const currentSize = () => document.documentElement.dataset.text ?? "md";
  const paintSize = () => {
    for (const button of sizeButtons) button.setAttribute("aria-pressed", String(button.dataset.textSize === currentSize()));
  };
  for (const button of sizeButtons) {
    button.addEventListener("click", () => {
      const size = button.dataset.textSize!;
      if (size === "md") delete document.documentElement.dataset.text;
      else document.documentElement.dataset.text = size;
      try {
        if (size === "md") localStorage.removeItem("pdr.text-size");
        else localStorage.setItem("pdr.text-size", size);
      } catch {
        // Private mode: the size still applies for this visit.
      }
      paintSize();
    });
  }
  paintSize();

  // Star motion: the same key BaseLayout reads before first paint.
  const starSwitch = document.querySelector<HTMLButtonElement>("[data-stars-switch]");
  const paintStars = () => starSwitch?.setAttribute("aria-checked", String(document.documentElement.dataset.stars !== "off"));
  starSwitch?.addEventListener("click", () => {
    const off = document.documentElement.dataset.stars !== "off";
    if (off) document.documentElement.dataset.stars = "off";
    else delete document.documentElement.dataset.stars;
    try {
      if (off) localStorage.setItem("pdr.stars", "off");
      else localStorage.removeItem("pdr.stars");
    } catch {
      // Private mode: the choice still applies for this visit.
    }
    paintStars();
  });
  paintStars();

  document.querySelector("[data-reset]")?.addEventListener("click", () => {
    const status = statusOf("reset");
    if (!confirm("Tüm ilerleme silinecek. Yedek aldın mı?")) {
      if (status) status.textContent = "İptal edildi.";
      return;
    }
    reset();
    if (status) status.textContent = "İlerleme sıfırlandı.";
  });
</script>

<style>
  .settings {
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--spacing-12) var(--spacing-4) var(--spacing-16);
  }

  .settings__head h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
  }

  .settings__lead {
    margin-block-start: var(--spacing-2);
    color: var(--c-text-secondary);
  }

  .storage-error {
    margin-block-start: var(--spacing-4);
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px solid var(--c-danger);
    border-radius: var(--radius-lg);
    color: var(--c-danger);
    font-size: var(--text-sm);
  }

  .storage-error[hidden] {
    display: none;
  }

  /* ----------------------------------------------------------------- cards */
  .cards {
    display: grid;
    gap: var(--spacing-4);
    margin-block-start: var(--spacing-8);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    padding: var(--spacing-6);
    border-radius: 1.25rem;
  }

  .card__title {
    font-size: var(--text-lg);
  }

  /* -------------------------------------------------------------- progress */
  .progress {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .progress__gauge {
    position: relative;
    flex: none;
    inline-size: 6.5rem;
    block-size: 6.5rem;
  }

  .progress__gauge svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .progress__track {
    fill: none;
    stroke: var(--c-control-border);
    stroke-width: 7;
    opacity: 0.5;
  }

  .progress__fill {
    fill: none;
    stroke: var(--c-progress);
    stroke-width: 8;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-box: fill-box;
    transform-origin: center;
    transition: stroke-dashoffset var(--dur-slow) var(--e-out);
  }

  .progress__percent {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    grid-auto-flow: column;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .progress__percent small {
    font-size: 0.5em;
    color: var(--c-text-muted);
  }

  .progress__body {
    min-width: 0;
    flex: 1 1 auto;
  }

  .stats {
    display: grid;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-3);
  }

  .stats dt {
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* --------------------------------------------------------------- buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
  }

  .actions__status {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .actions__status:empty {
    display: none;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: 44px;
    padding-inline: var(--spacing-4);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--c-text) 4%, transparent);
    color: var(--c-text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--e-out),
      background-color var(--dur) var(--e-out);
  }

  .button:hover {
    border-color: var(--c-action);
    color: var(--c-text);
  }

  .button:has(input:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .button svg {
    inline-size: 18px;
    block-size: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .button--primary {
    border-color: transparent;
    background-color: var(--c-action-surface);
    color: var(--c-on-action);
  }

  .button--primary:hover {
    background-color: var(--c-action-hover);
    color: var(--c-on-action);
  }

  .button--danger {
    border-color: var(--c-danger);
    color: var(--c-danger);
  }

  /* -------------------------------------------------------------- advanced */
  .advanced summary,
  .danger__summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .advanced[open] summary {
    margin-block-end: var(--spacing-2);
  }

  .field-label {
    display: block;
    margin-block: var(--spacing-3) var(--spacing-1);
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  .json {
    inline-size: 100%;
    padding: var(--spacing-3);
    border: 1px solid var(--c-control-border);
    border-radius: var(--radius-md);
    background-color: var(--c-surface-sunken);
    color: var(--c-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    resize: vertical;
  }

  /* ------------------------------------------------------------ appearance */
  .setting__label {
    font-weight: 600;
  }

  .setting__hint {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .segmented {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-1);
    margin-block-start: calc(var(--spacing-2) * -1);
    padding: var(--spacing-1);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    background-color: var(--c-surface-sunken);
  }

  .segmented button {
    min-height: 40px;
    padding-inline: var(--spacing-1);
    white-space: nowrap;
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--c-text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  /* Selected: a lifted capsule and bold text, not colour alone. */
  .segmented button[aria-pressed="true"] {
    background-color: var(--c-surface-overlay);
    color: var(--c-text);
    font-weight: 600;
    box-shadow: var(--elev-1), 0 0 0 1px var(--c-border-strong);
  }

  .setting__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding-block-start: var(--spacing-4);
    border-top: 1px solid var(--c-border);
  }

  /* On/off switch: the thumb's position carries the state; the track colour
     only repeats it. */
  .switch {
    position: relative;
    flex: none;
    inline-size: 52px;
    block-size: 32px;
    padding: 0;
    border: 1px solid var(--c-control-border);
    border-radius: var(--radius-full);
    background-color: var(--c-surface-sunken);
    cursor: pointer;
    transition: background-color var(--dur) var(--e-out);
  }

  .switch__thumb {
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    inline-size: 24px;
    block-size: 24px;
    border-radius: 50%;
    background-color: var(--c-text-secondary);
    transition:
      translate var(--dur-slow) var(--e-spring),
      background-color var(--dur) var(--e-out);
  }

  .switch[aria-checked="true"] {
    border-color: var(--c-progress);
    background-color: color-mix(in oklab, var(--c-progress) 30%, var(--c-surface-sunken));
  }

  .switch[aria-checked="true"] .switch__thumb {
    translate: 20px 0;
    background-color: var(--c-progress);
  }

  .offline {
    margin-block-start: auto;
  }

  /* ---------------------------------------------------------------- danger */
  .danger {
    padding-block: var(--spacing-2);
    border: 1px dashed color-mix(in oklab, var(--c-danger) 50%, transparent);
    gap: var(--spacing-3);
  }

  .danger[open] {
    padding-block-end: var(--spacing-6);
  }

  .danger__summary {
    color: var(--c-danger);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .settings {
      padding-inline: var(--spacing-6);
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--wide {
      grid-column: 1 / -1;
    }

    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
