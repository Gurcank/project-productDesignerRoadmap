---
import BaseLayout from "~/layouts/BaseLayout.astro";
import GalaxyMap from "~/components/GalaxyMap.astro";
import WaveButton from "~/components/ui/WaveButton.astro";
import { getPublishedCategories, topicId, topicHref } from "~/lib/content";

const published = await getPublishedCategories();
const publishedSlugs = new Set(published.map((entry) => entry.category.slug));
const topicIdsByCategory = Object.fromEntries(
  published.map(({ category, topics }) => [category.slug, topics.map((topic) => topicId(topic))]),
);
// The "continue" card needs a real title, not a prettified slug.
const topicTitles = Object.fromEntries(
  published.flatMap(({ category, topics }) =>
    topics.map((topic) => [topicId(topic), `${category.title} · ${topic.data.title}`]),
  ),
);
const totalTopics = published.reduce((sum, entry) => sum + entry.topics.length, 0);
const first = published[0];
const firstHref = first?.topics[0] ? topicHref(first.topics[0]) : "/";
const firstDetail = first?.topics[0] ? `${first.category.title} · ${first.topics[0].data.title}` : "";
---

<BaseLayout title="Yol haritası" section="roadmap">
  <div class="home">
    <h1 class="sr-only">Product Designer yol haritası</h1>

    {/* Mission card: one gauge, two numbers, one action. */}
    <section class="mission glass" aria-label="İlerlemen">
      <div class="mission__gauge" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle class="mission__track" cx="60" cy="60" r="52" />
          <circle
            class="mission__fill"
            cx="60"
            cy="60"
            r="52"
            pathLength="100"
            stroke-dasharray="100"
            stroke-dashoffset="100"
            data-progress-ring
          />
        </svg>
        <span class="mission__percent"><span data-progress-percent>0</span><small>%</small></span>
      </div>

      <div class="mission__stats">
        <p class="mission__eyebrow">Yolculuğun</p>
        <p class="mission__count">
          <strong data-progress-done>0</strong>
          <span>/ {totalTopics} ders</span>
        </p>
        <p class="mission__meta">
          Tamamlanan gezegen <strong data-planets-done>0</strong> / {published.length}
        </p>
      </div>

      <div class="mission__action">
        <WaveButton
          href={firstHref}
          label="Yolculuğa başla"
          detail={firstDetail}
          attrs={{ "data-continue": true }}
        />
      </div>

      <script type="application/json" id="topic-titles" set:html={JSON.stringify(topicTitles)} />
    </section>

    <p class="home__hint">Gezegenlere dokun ve aç · basılı tutup sürükle</p>

    <GalaxyMap publishedSlugs={publishedSlugs} topicIdsByCategory={topicIdsByCategory} />
  </div>
</BaseLayout>

<script>
  import { initProgress, $progress, summarise } from "~/lib/progress";

  initProgress();

  const planets = Array.from(document.querySelectorAll<HTMLElement>("[data-topic-ids]")).map((node) =>
    (node.dataset.topicIds ?? "").split(" ").filter(Boolean),
  );
  const allIds = planets.flat();

  const doneEl = document.querySelector<HTMLElement>("[data-progress-done]");
  const percentEl = document.querySelector<HTMLElement>("[data-progress-percent]");
  const ring = document.querySelector<SVGCircleElement>("[data-progress-ring]");
  const planetsDone = document.querySelector<HTMLElement>("[data-planets-done]");
  const continueLink = document.querySelector<HTMLAnchorElement>("[data-continue]");
  const label = continueLink?.querySelector<HTMLElement>("[data-wave-label]") ?? null;
  const detail = continueLink?.querySelector<HTMLElement>("[data-wave-detail]") ?? null;

  const titles: Record<string, string> = JSON.parse(document.getElementById("topic-titles")?.textContent ?? "{}");

  $progress.subscribe((progress) => {
    const summary = summarise(allIds, progress);
    if (doneEl) doneEl.textContent = String(summary.done);
    if (percentEl) percentEl.textContent = String(summary.percent);
    if (ring) ring.style.strokeDashoffset = String(100 - summary.percent);
    if (planetsDone) {
      planetsDone.textContent = String(
        planets.filter((ids) => {
          const s = summarise(ids, progress);
          return s.total > 0 && s.done === s.total;
        }).length,
      );
    }

    // First visit: "Yolculuğa başla" into the first lesson. After that: continue
    // where you were, if that lesson still exists in this build.
    const last = progress.last?.topic;
    if (continueLink && label && detail && last && titles[last]) {
      continueLink.href = `/${last}/`;
      label.textContent = "Devam et";
      detail.textContent = titles[last];
    }
  });
</script>

<style>
  .home {
    max-width: 76rem;
    margin-inline: auto;
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-16);
  }

  /* --------------------------------------------------------------- mission */
  .mission {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-4) var(--spacing-6);
    padding: var(--spacing-6);
    border-radius: 1.5rem;
  }

  .mission__gauge {
    position: relative;
    inline-size: 6.5rem;
    block-size: 6.5rem;
  }

  .mission__gauge svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .mission__track {
    fill: none;
    stroke: var(--c-control-border);
    stroke-width: 7;
    opacity: 0.5;
  }

  .mission__fill {
    fill: none;
    stroke: var(--c-progress);
    stroke-width: 8;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-box: fill-box;
    transform-origin: center;
    filter: drop-shadow(0 0 6px var(--c-progress));
    transition: stroke-dashoffset var(--dur-slow) var(--e-out);
  }

  .mission__percent {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    grid-auto-flow: column;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    color: var(--c-text);
  }

  .mission__percent small {
    font-size: 0.5em;
    color: var(--c-text-muted);
  }

  .mission__eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-action);
  }

  .mission__count {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-1);
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .mission__count strong {
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-progress-text);
  }

  .mission__count span {
    font-size: var(--text-lg);
    color: var(--c-text-secondary);
  }

  .mission__meta {
    margin-block-start: var(--spacing-2);
    white-space: nowrap;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .mission__meta strong {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-text);
  }

  .mission__action {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .mission__action :global(.wave) {
    inline-size: 100%;
    justify-content: space-between;
    min-height: 56px;
    border-radius: var(--radius-lg);
  }

  .home__hint {
    margin-block: var(--spacing-8) var(--spacing-6);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--c-text-muted);
  }

  @media (min-width: 48rem) {
    .home {
      padding-inline: var(--spacing-6);
    }

    .mission {
      grid-template-columns: auto minmax(0, 1fr) minmax(16rem, 22rem);
      padding: var(--spacing-8);
    }

    .mission__gauge {
      inline-size: 8rem;
      block-size: 8rem;
    }

    .mission__action {
      grid-column: auto;
    }
  }
</style>
