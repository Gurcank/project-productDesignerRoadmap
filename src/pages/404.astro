---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedCategories } from "~/lib/content";

// A dead end needs a way out, and the most likely one is the category the URL
// was pointing at — so offer the real list rather than a generic apology.
const published = await getPublishedCategories();
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığın sayfa burada değil.">
  <div class="notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1>Bu sayfa yok</h1>
    <p class="notfound__lead">
      Adres yanlış olabilir ya da bir adımın slug'ı değişmiş olabilir. Aşağıdan devam edebilirsin.
    </p>

    <div class="notfound__actions">
      <a class="notfound__primary" href="/">Yol haritasına dön</a>
      <a class="notfound__secondary" href="/ara/">Ara</a>
      <a class="notfound__secondary" href="/sozluk/">Sözlük</a>
    </div>

    <section class="notfound__list" aria-labelledby="kategoriler">
      <h2 id="kategoriler">Kategoriler</h2>
      <ul>
        {
          published.map(({ category, topics }) => (
            <li>
              <a href={`/${category.slug}/`}>{category.title}</a>
              <span>{topics.length} adım</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: 52rem;
    margin-inline: auto;
    padding: var(--spacing-12) var(--spacing-4) var(--spacing-16);
  }

  .notfound__code {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: var(--c-text-muted);
  }

  .notfound h1 {
    margin-block-start: var(--spacing-2);
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }

  .notfound__lead {
    max-width: var(--measure);
    margin-block-start: var(--spacing-3);
    color: var(--c-text-secondary);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-6);
  }

  .notfound__primary,
  .notfound__secondary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--spacing-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .notfound__primary {
    background-color: var(--c-action-surface);
    color: var(--c-on-action);
    font-weight: 500;
  }

  .notfound__primary:hover {
    background-color: var(--c-action);
  }

  .notfound__secondary {
    border: 1px solid var(--c-control-border);
    color: var(--c-text);
  }

  .notfound__secondary:hover {
    background-color: var(--c-surface-raised);
  }

  .notfound__list {
    margin-block-start: var(--spacing-12);
  }

  .notfound__list h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
  }

  .notfound__list ul {
    display: grid;
    gap: var(--spacing-px);
    margin-block-start: var(--spacing-3);
    padding: 0;
    list-style: none;
  }

  .notfound__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding-block: var(--spacing-2);
    border-bottom: 1px solid var(--c-border);
  }

  .notfound__list a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--c-text);
    text-decoration: none;
  }

  .notfound__list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .notfound__list span {
    flex: 0 0 auto;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  @media (min-width: 48rem) {
    .notfound {
      padding-inline: var(--spacing-6);
    }

    .notfound__list ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--spacing-8);
    }
  }
</style>
