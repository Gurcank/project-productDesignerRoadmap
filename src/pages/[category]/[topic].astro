---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import StepList from "~/components/StepList.astro";
import { getPublishedCategories, topicHref, topicId, topicSlug } from "~/lib/content";
import { DIAGRAM_BY_SECTION } from "~/components/diagrams";
import { getGlossary } from "~/lib/glossary";
import TermTooltips from "~/components/TermTooltips.astro";
import BrowseNav from "~/components/ui/BrowseNav.astro";
import { ROLE_LABEL } from "~/data/role-ids";
import { TIER_LABEL } from "~/data/roles";
import { getRoutes, getStepTiers, groupStates } from "~/lib/routes";
import { nextInPath } from "~/lib/role-path";

export async function getStaticPaths() {
  const published = await getPublishedCategories();
  return published.flatMap(({ category, topics }) =>
    topics.map((topic, index) => ({
      params: { category: category.slug, topic: topicSlug(topic) },
      props: {
        category,
        topics,
        topic,
        previous: index > 0 ? topics[index - 1] : null,
        next: index < topics.length - 1 ? topics[index + 1] : null,
      },
    })),
  );
}

const { category, topics, topic, previous, next } = Astro.props;
const id = topicId(topic);

/*
 * A hand-written lesson replaces the term-card view of its step (ADR-015). The
 * imported topic stays the source of the glossary and of the step order, so
 * progress keys, URLs and search anchors do not move.
 */
const lesson = (await getCollection("lessons")).find((entry) => entry.id === id);
const { Content, headings } = await render(lesson ?? topic);
const cardHeadings = lesson
  ? headings.filter((heading) => heading.depth === 2 && heading.slug !== "ozet")
  : headings.filter((heading) => heading.depth === 3);

const lessonTerms = lesson
  ? (await getGlossary()).filter((entry) => entry.href.startsWith(`/${id}/`))
  : [];
const lessonSources = lesson?.data.sources ?? topic.data.sources;
const lessonFlags = lesson ? lesson.data.flags : topic.data.flags;

// Categories written for this site have no quiz; linking to one would 404.
const quizzes = await getCollection("quizzes");
const hasQuiz = quizzes.some((quiz) => quiz.data.category === category.slug);

/*
 * The diagram sits between the section intro and the term cards: the intro says
 * what the section is about, the drawing shows the shape of it, then the cards
 * name the parts. Keyed by section number so the imported markdown stays
 * untouched (ADR-002).
 */
const Diagram = lesson ? null : (DIAGRAM_BY_SECTION[topic.data.sectionNumber as keyof typeof DIAGRAM_BY_SECTION] ?? null);

// This step on each role's route: its tier, and where the route goes next.
const tiers = (await getStepTiers()).get(id) ?? [];
const tierGroups = groupStates(
  tiers.map(({ state, tier }) => ({ state, value: tier })),
  (tier) => tier,
);
const titleById = new Map(
  (await getPublishedCategories()).flatMap(({ category: owner, topics: list }) =>
    list.map((entry) => [topicId(entry), { title: entry.data.title, category: owner.title }] as const),
  ),
);
// Only where it differs from the pager: at a category's end the route jumps on.
const pagerNext = next ? topicId(next) : null;
const routeNext = groupStates(
  (await getRoutes())
    .filter((route) => route.state !== "all")
    .flatMap((route) => {
      const step = nextInPath(route, id);
      return step && step.id !== pagerNext ? [{ state: route.state, value: step.id }] : [];
    }),
  (target) => target,
);
// Search can narrow to a role: a step counts for roles where it is temel or önerilen.
const searchRoles = tiers.filter(({ tier }) => tier !== "istege-bagli").map(({ state }) => ROLE_LABEL[state].name);

const FLAG_LABEL: Record<string, { text: string; title: string }> = {
  degisken: {
    text: "Değişken bilgi",
    title: "Bu adımda hızlı eskiyen bilgi var — kullanmadan önce doğrula.",
  },
  "emin-degil": {
    text: "Emin değilim",
    title: "Kaynak, bu noktada kesin olmadığını belirtiyor.",
  },
};
---

<BaseLayout title={topic.data.title} description={`${category.title} · ${topic.data.title}`} section="roadmap">
  <div class="topic">
    <aside class="topic__nav" aria-label={`${category.title} adımları`}>
      <StepList
        titleHref={`/${category.slug}/`}
        topics={topics}
        activeId={id}
        categorySlug={category.slug}
        categoryTitle={category.title}
        quizHref={hasQuiz ? `/${category.slug}/test/` : undefined}
      />
    </aside>

    {/* Pagefind indexes only what carries data-pagefind-body, so marking the
        article here is what keeps the header, the step rail and the pager out
        of every search result. */}
    <article
      class="topic__main"
      data-topic-page={id}
      data-pagefind-body
      data-pagefind-filter={`kategori:${category.title}`}
      data-pagefind-meta={`kategori:${category.title}`}
    >
      <span hidden data-pagefind-filter="tur:Ders"></span>
      {searchRoles.map((name) => <span hidden data-pagefind-filter={`rol:${name}`}></span>)}
      <header class="topic__head">
        {/* One line of facts above the title: where you are, how long, caveats. */}
        <p class="topic__eyebrow">
          <a class="topic__category" href={`/${category.slug}/`}>{category.title}</a>
          {
            tierGroups.map((group) => (
              <span class="topic__chip topic__tier" data-tier={TIER_LABEL[group.value].code} data-for-role={group.states.join(" ")}>
                <span class="sr-only">Rolün için: </span>
                {TIER_LABEL[group.value].label}
              </span>
            ))
          }
          {topic.data.sectionNumber && <span class="topic__chip">{topic.data.sectionNumber}</span>}
          {lesson ? (
            <span class="topic__chip">~{lesson.data.minutes ?? 8} dk</span>
          ) : (
            topic.data.cardCount > 0 && <span class="topic__chip">{topic.data.cardCount} terim</span>
          )}
          {
            /* Pages written for this site must say so on their face — the whole
               point of the material is that it is the user's own verified source. */
            topic.data.origin === "new" && (
              <span class="flag flag--new" title="Bu sayfa referans dosyasında yok; bu site için yazıldı.">
                Materyal dışı
              </span>
            )
          }
          {
            lessonFlags.map((flag) => (
              <span class="flag" title={FLAG_LABEL[flag]?.title}>
                {FLAG_LABEL[flag]?.text ?? flag}
              </span>
            ))
          }
        </p>
        <h1>{topic.data.title}</h1>
        {lesson && <p class="topic__summary">{lesson.data.summary}</p>}
        {
          lesson && lesson.data.outcomes.length > 0 && (
            <div class="lesson-outcomes">
              <p class="lesson-outcomes__title">Bu derste öğreneceklerin</p>
              <ul>
                {lesson.data.outcomes.map((outcome) => (
                  <li>{outcome}</li>
                ))}
              </ul>
            </div>
          )
        }
      </header>

      {Diagram && <Diagram />}

      <div class="prose content">
        <Content />
      </div>

      {
        lessonTerms.length > 0 && (
          <details class="lesson-terms" data-pagefind-ignore>
            <summary>Bu derste geçen terimler ({lessonTerms.length})</summary>
            <dl>
              {lessonTerms.map((entry) => (
                <div>
                  <dt>{entry.term}</dt>
                  <dd>{entry.definition}</dd>
                </div>
              ))}
            </dl>
          </details>
        )
      }

      {/* Controls and navigation live inside the indexed article; they are
          not content, so they are excluded from the index explicitly. */}
      {
        lessonSources.length > 0 && (
          <aside class="sources" aria-labelledby="kaynaklar">
            <h2 id="kaynaklar" class="sources__title">
              Kaynaklar
            </h2>
            <ul>
              {lessonSources.map((source) => (
                <li>
                  <a href={source.url} rel="noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <div class="topic__done" data-pagefind-ignore>
        <button type="button" class="done" aria-pressed="false" data-done-toggle>
          <span class="done__tick" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg>
          </span>
          <span data-done-label>Bu dersi bitirdim</span>
        </button>
      </div>

      <nav class="pager" aria-label="Adımlar arası gezinme" data-pagefind-ignore>
        <BrowseNav
          direction="back"
          href={previous ? topicHref(previous) : undefined}
          kicker="Önceki"
          title={previous ? previous.data.title : "Bu kategorinin ilk adımı"}
        />
        {
          next ? (
            <BrowseNav
              direction="forward"
              href={topicHref(next)}
              kicker="Sonraki"
              title={next.data.title}
              attrs={{ "data-advance": true }}
            />
          ) : hasQuiz ? (
            <BrowseNav
              direction="forward"
              href={`/${category.slug}/test/`}
              kicker="Son adım"
              title="Kendini test et"
              attrs={{ "data-advance": true }}
            />
          ) : (
            <BrowseNav
              direction="forward"
              href="/"
              kicker="Son adım"
              title="Yol haritasına dön"
              attrs={{ "data-advance": true }}
            />
          )
        }
      </nav>

      {
        routeNext.map((group) => {
          const target = titleById.get(group.value);
          return (
            target && (
              <p class="route-next" data-for-role={group.states.join(" ")} data-pagefind-ignore>
                Yolunda sıradaki:{" "}
                <a href={`/${group.value}/`}>
                  {target.category} · {target.title}
                </a>
              </p>
            )
          );
        })
      }
    </article>

    {
      cardHeadings.length > 2 && (
        <aside class="topic__toc" aria-label={lesson ? "Bu dersin bölümleri" : "Bu sayfadaki terimler"}>
          <p class="topic__toc-title">{lesson ? "Bu derste" : "Bu sayfadaki terimler"}</p>
          <ol>
            {cardHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>

  <div class="resume" data-resume hidden>
    <button type="button" class="resume__go" data-resume-go>
      Kaldığın yerden devam et · %<span data-resume-pct></span>
    </button>
    <button type="button" class="resume__close" data-resume-close aria-label="Kapat">×</button>
  </div>

  <TermTooltips />
</BaseLayout>

<script>
  import { initProgress, $progress, markVisited, setDone } from "~/lib/progress";
  import { getPosition, savePosition } from "~/lib/reading-position";

  initProgress();

  const page = document.querySelector<HTMLElement>("[data-topic-page]");
  if (page) {
    const id = page.dataset.topicPage!;
    markVisited(id);

    /*
     * Remember where you stopped, offer to go back (never jump on our own: an
     * unrequested scroll on load is disorienting), and drop the offer as soon as
     * you start reading somewhere else.
     */
    const maxScroll = () => document.documentElement.scrollHeight - window.innerHeight;
    const resume = document.querySelector<HTMLElement>("[data-resume]");
    const saved = getPosition(id);

    if (resume && saved > 0.05 && saved < 0.96 && !location.hash && window.scrollY < 80) {
      resume.querySelector<HTMLElement>("[data-resume-pct]")!.textContent = String(Math.round(saved * 100));
      resume.hidden = false;
      const hide = () => (resume.hidden = true);
      resume.querySelector("[data-resume-go]")?.addEventListener("click", () => {
        window.scrollTo({ top: saved * maxScroll(), behavior: "smooth" });
        hide();
      });
      resume.querySelector("[data-resume-close]")?.addEventListener("click", hide);
      window.setTimeout(hide, 12000);
    }

    let saveTimer: number | undefined;
    const save = () => {
      const max = maxScroll();
      if (max > 0) savePosition(id, window.scrollY / max);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (resume && !resume.hidden && window.scrollY > 400) resume.hidden = true;
        window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(save, 600);
      },
      { passive: true },
    );
    document.addEventListener("visibilitychange", () => document.visibilityState === "hidden" && save());
    window.addEventListener("pagehide", save);

    /*
     * Moving forward means you are done with this one. Reaching the next step
     * and finding this one still unticked was the surest way for the progress
     * count to drift from what had actually been read.
     */
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-advance]")) {
      link.addEventListener("click", () => setDone(id, true));
    }

    /*
     * Swipe between steps, touch only. Horizontal movement must clearly beat
     * vertical or every attempt to scroll the page would fire a navigation,
     * and a gesture that starts inside a table or diagram belongs to that
     * container's own horizontal scroll, not to us.
     */
    const prevHref = document.querySelector<HTMLAnchorElement>('.pager a[rel="prev"]')?.href;
    const nextHref = document.querySelector<HTMLAnchorElement>("[data-advance]")?.href;
    let startX = 0;
    let startY = 0;

    page.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0]!;
        startX = touch.clientX;
        startY = touch.clientY;
      },
      { passive: true },
    );

    page.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0]!;
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 2) return;
        if ((event.target as Element).closest(".table-scroll, .diagram__canvas")) return;

        if (dx < 0 && nextHref) {
          setDone(id, true);
          location.href = nextHref;
        } else if (dx > 0 && prevHref) {
          location.href = prevHref;
        }
      },
      { passive: true },
    );

    // The done button and the sidebar tick are two views of one value.
    const doneButton = page.querySelector<HTMLButtonElement>("[data-done-toggle]");
    const doneLabel = doneButton?.querySelector<HTMLElement>("[data-done-label]");
    if (doneButton) {
      doneButton.addEventListener("click", () => setDone(id, doneButton.getAttribute("aria-pressed") !== "true"));
      $progress.subscribe((progress) => {
        const done = progress.topics[id]?.done === true;
        doneButton.setAttribute("aria-pressed", String(done));
        if (doneLabel) doneLabel.textContent = done ? "Tamamlandı" : "Bu dersi bitirdim";
      });
    }
  }
</script>

<style>
  .topic {
    display: grid;
    gap: var(--spacing-12);
    max-width: 90rem;
    margin-inline: auto;
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-24);
  }

  /* Phone: content first, step list after it. Desktop: list becomes the rail. */
  /* One reading column: head, prose, sources and pager share its edges, so the
     page has a single left line instead of four. 42rem at the 17px lesson size is
     ~70ch — Turkish needs the room, but not more. */
  .topic__main {
    order: 1;
    min-width: 0;
    inline-size: 100%;
    max-inline-size: 46rem;
    margin-inline: auto;
    padding: var(--spacing-6) var(--spacing-4) var(--spacing-8);
    border: 1px solid var(--c-border);
    border-radius: 1.5rem;
    background-color: var(--c-surface-reading);
    box-shadow: var(--elev-card);
    font-size: 1.0625rem;
  }

  @media (min-width: 40rem) {
    .topic__main {
      padding: var(--spacing-12) var(--spacing-12) var(--spacing-12);
    }
  }

  .topic__nav {
    order: 2;
  }

  .topic__toc {
    order: 3;
    font-size: var(--text-sm);
  }

  .topic__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--c-text-secondary);
  }

  .topic__category,
  .topic__chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding-inline: var(--spacing-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--c-border);
    font-variant-numeric: tabular-nums;
  }

  /* The category chip is the way back up; it reads as a link (action colour). */
  .topic__category {
    border-color: color-mix(in oklab, var(--c-action) 40%, var(--c-border));
    background-color: color-mix(in oklab, var(--c-action) 10%, transparent);
    color: var(--c-action);
    font-weight: 600;
    text-decoration: none;
  }

  .topic__category::before {
    content: "←";
    margin-inline-end: var(--spacing-1);
  }

  .topic__category:hover {
    color: var(--c-action-hover);
    border-color: var(--c-action);
  }

  .topic__chip {
    color: var(--c-text-muted);
  }

  .topic__tier {
    border-color: var(--c-text-secondary);
    color: var(--c-text);
    font-weight: 600;
  }

  .topic__tier[data-tier="t"] {
    border-color: var(--c-text);
    background-color: var(--c-text);
    color: var(--c-surface);
  }

  .topic__tier[data-tier="i"] {
    border-style: dashed;
    color: var(--c-text-secondary);
  }

  /* The lesson's one-sentence promise ("Tek cümlede", lesson standard v2). */
  .topic__summary {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--c-text-secondary);
  }

  .route-next {
    margin-block-start: var(--spacing-4);
    padding: var(--spacing-3) var(--spacing-4);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .topic__head h1 {
    margin-block: var(--spacing-4) 0;
    font-size: var(--text-3xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .content {
    margin-block-start: var(--spacing-12);
  }

  @media (max-width: 40rem) {
    .content {
      margin-block-start: var(--spacing-8);
    }
  }

  /* The badge that marks a page as written for this site, not imported. */
  .flag--new {
    border-color: var(--c-progress);
    color: var(--c-progress-text);
  }

  .sources {
    margin-block-start: var(--spacing-16);
    padding: var(--spacing-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-surface-raised);
  }

  .sources__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
  }

  .sources ul {
    margin-block-start: var(--spacing-2);
    padding-inline-start: var(--spacing-4);
    font-size: var(--text-sm);
  }

  .sources li + li {
    margin-block-start: var(--spacing-1);
  }

  /* One explicit "done" control. Advancing with "Sonraki" also marks done. */
  .topic__done {
    display: flex;
    justify-content: center;
    margin-block-start: var(--spacing-12);
  }

  .done {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-3);
    min-height: 48px;
    padding: var(--spacing-2) var(--spacing-6) var(--spacing-2) var(--spacing-3);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--c-text) 4%, transparent);
    color: var(--c-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--e-out),
      background-color var(--dur) var(--e-out);
  }

  .done:hover {
    border-color: var(--c-progress);
  }

  .done__tick {
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: 50%;
    border: 2px solid var(--c-control-border);
    transition:
      background-color var(--dur) var(--e-out),
      border-color var(--dur) var(--e-out);
  }

  .done__tick svg {
    inline-size: 16px;
    block-size: 16px;
    fill: none;
    stroke: var(--c-on-progress);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }

  /* Done: a filled tick plus the word "Tamamlandı" — never colour alone. */
  .done[aria-pressed="true"] {
    border-color: var(--c-progress);
    background-color: color-mix(in oklab, var(--c-progress) 12%, transparent);
  }

  .done[aria-pressed="true"] .done__tick {
    border-color: var(--c-progress);
    background-color: var(--c-progress);
  }

  .done[aria-pressed="true"] .done__tick svg {
    opacity: 1;
  }

  /* Floats above the bottom bar on a phone; on desktop there is no bar to clear. */
  .resume {
    position: fixed;
    inset-inline: var(--spacing-4);
    inset-block-end: calc(5.5rem + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-overlay);
    display: flex;
    justify-content: center;
    gap: var(--spacing-1);
    pointer-events: none;
  }

  .resume[hidden] {
    display: none;
  }

  .resume__go,
  .resume__close {
    pointer-events: auto;
    min-height: 44px;
    border: 1px solid var(--c-border-strong);
    background-color: var(--c-surface-overlay);
    color: var(--c-text);
    font: inherit;
    font-size: var(--text-sm);
    box-shadow: var(--elev-2);
    cursor: pointer;
  }

  .resume__go {
    padding-inline: var(--spacing-4);
    border-radius: var(--radius-full) 0 0 var(--radius-full);
  }

  .resume__close {
    min-inline-size: 44px;
    border-radius: 0 var(--radius-full) var(--radius-full) 0;
    border-inline-start: 0;
  }

  @media (min-width: 64rem) {
    .resume {
      inset-block-end: var(--spacing-6);
    }
  }

  .pager {
    display: grid;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-6);
  }

  .topic__toc ol {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    margin-block-start: var(--spacing-2);
    padding: 0;
    list-style: none;
  }

  .topic__toc a {
    color: var(--c-text-secondary);
    text-decoration: none;
  }

  .topic__toc a:hover {
    color: var(--c-text);
  }

  .topic__toc-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .topic {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--spacing-12);
      padding-inline: var(--spacing-6);
      padding-block-start: var(--spacing-12);
      align-items: start;
    }

    .topic__nav {
