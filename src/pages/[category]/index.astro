---
import { getCollection, getEntry, render } from "astro:content";
import { getGlossary } from "~/lib/glossary";
import BaseLayout from "~/layouts/BaseLayout.astro";
import StepList from "~/components/StepList.astro";
import { getPublishedCategories, topicMinutes, formatDuration, topicHref, topicId } from "~/lib/content";
import { DURABILITY_LABEL, AREAS } from "~/data/categories";
import ActivityBadge from "~/components/ui/ActivityBadge.astro";
import ProgressBar from "~/components/ui/ProgressBar.astro";
import WaveButton from "~/components/ui/WaveButton.astro";
import TermTooltips from "~/components/TermTooltips.astro";
import OfflineDownload from "~/components/OfflineDownload.astro";
import { planetOf } from "~/data/planets";
import { ROLE_LABEL, type RoleState } from "~/data/role-ids";
import { TIER_LABEL } from "~/data/roles";
import { getRoutes, groupStates } from "~/lib/routes";

export async function getStaticPaths() {
  const published = await getPublishedCategories();
  return published.map(({ category, topics }) => ({
    params: { category: category.slug },
    props: { category, topics },
  }));
}

const { category, topics } = Astro.props;
/*
 * A hand-written landing (src/lessons/<category>/_index.mdx, ADR-015) replaces
 * the imported chapter intro, and brings the lesson path and a short glossary
 * with it. Categories without one keep the imported intro.
 */
const lessons = await getCollection("lessons");
const landing = lessons.find((entry) => entry.id === `${category.slug}/_index`);
const intro = landing ?? (await getEntry("categories", category.slug));
const Intro = intro ? (await render(intro)).Content : null;

const lessonById = new Map(lessons.map((entry) => [entry.id, entry]));
const path = landing
  ? topics.map((topic) => ({ topic, lesson: lessonById.get(topicId(topic)) }))
  : [];

const glossary = landing ? (await getGlossary()).filter((entry) => entry.categorySlug === category.slug) : [];
const glossaryGroups = path
  .map(({ topic }) => ({
    title: topic.data.title,
    number: topic.data.sectionNumber,
    href: topicHref(topic),
    terms: glossary.filter((entry) => entry.topicTitle === topic.data.title),
  }))
  .filter((group) => group.terms.length > 0);

const durability = DURABILITY_LABEL[category.durability];
const area = AREAS.find((a) => a.id === category.area);
const cards = topics.reduce((sum, topic) => sum + topic.data.cardCount, 0);
const minutes = topics.reduce(
  (sum, topic) => sum + (lessonById.get(topicId(topic))?.data.minutes ?? topicMinutes(topic)),
  0,
);

// Where this category sits on each role's route, or that it is not on it.
const routes = (await getRoutes()).filter((route) => route.state !== "all");
const onRoute = routes.flatMap((route) => {
  const stop = route.stops.find((s) => s.category === category.slug);
  return stop ? [{ state: route.state as RoleState, stop }] : [];
});
const offRoute = groupStates(
  routes.filter((route) => route.offPath.includes(category.slug)).map((route) => ({ state: route.state, value: true })),
  () => "off",
);
const firstTopic = topics[0];
const planet = planetOf(category.slug);

// Categories written for this site have no quiz; linking to one would 404.
const quizzes = await getCollection("quizzes");
const hasQuiz = quizzes.some((quiz) => quiz.data.category === category.slug);
---

{/* Same skeleton as a topic page: steps on the left, reading column on the
    right. A category and its steps are the same place at different zoom, so
    moving the rail between them made the site feel like two sites. */}
<BaseLayout title={category.title} description={category.summary} section="roadmap">
  <div class="category">
    <aside class="category__rail" aria-label={`${category.title} adımları`}>
      <StepList
        titleHref="/"
        titleLabel="Yol haritası"
        meter={false}
        topics={topics}
        categorySlug={category.slug}
        categoryTitle={category.title}
        quizHref={hasQuiz ? `/${category.slug}/test/` : undefined}
      />
    </aside>

    <article class="category__main">
      <header class="category__head">
        <span class:list={["category__planet", { "planet-rings": planet.ring }]} data-body={planet.body} aria-hidden="true">
          <span class="planet-disc" data-body={planet.body} data-pattern={planet.pattern}></span>
        </span>
        <p class="category__eyebrow" style={`--area: var(--c-area-${category.area})`}>{area?.title}</p>
        <h1 class="category__title">{category.title}</h1>

        {/* One line, not a four-box grid: these are four small facts, and a grid
            of labelled boxes gave them more weight than they carry. */}
        <p class="facts">
          <span><b>{topics.length}</b> adım</span>
          {cards > 0 && <span><b>{cards}</b> terim</span>}
          <span>{formatDuration(minutes)}</span>
          <span class="facts__life">
            <ActivityBadge tone={category.durability} label="Bilgi ömrü:" />
            {durability.label}
          </span>
        </p>

        {
          onRoute.map(({ state, stop }) => (
            <p class="route-stop" data-for-role={state}>
              <span class="route-stop__tier" data-tier={TIER_LABEL[stop.tier].code}>{TIER_LABEL[stop.tier].label}</span>
              {ROLE_LABEL[state].name} yolunda {stop.position}. durak · {TIER_LABEL[stop.tier].help}
            </p>
          ))
        }
        {
          offRoute.map((group) => (
            <p class="route-stop route-stop--off" data-for-role={group.states.join(" ")}>
              Bu bölüm senin rolünün yolunda yok; yine de açık, keşif için oku.
            </p>
          ))
        }
      </header>

      <div class="start" data-start={category.slug}>
        <WaveButton
          href={firstTopic ? topicHref(firstTopic) : "/"}
          label="Başla"
          detail={firstTopic?.data.title}
          attrs={{ "data-start-link": true }}
        />

        {/* Wrapper, not a class on the component: a class passed to a child
            component's root does not carry this page's style scope, so the
            track was being laid out at zero width. */}
        <div class="start__progress">
          <ProgressBar fillAttribute="data-progress-bar" />
        </div>
        <p class="start__count"><span data-progress-done>0</span>/{topics.length}</p>
      </div>

      <div class="category__offline">
        <OfflineDownload scope={category.slug} label="Bu bölümü çevrimdışı indir" />
      </div>

      <div class="category__intro prose">
        {Intro && <Intro />}
      </div>

      {
        glossaryGroups.length > 0 && (
          <section class="mini-glossary" aria-labelledby="mini-sozluk">
            <h2 id="mini-sozluk" class="path__title">Bu bölümün sözlüğü · {glossary.length} terim</h2>
            <p class="mini-glossary__hint">Derslerde terimin üzerine gelince ya da dokununca açıklaması çıkar; burası tekrar için.</p>
            {glossaryGroups.map((group) => (
              <details class="mini-glossary__group">
                <summary>
                  <span class="path__num">{group.number}</span> {group.title} <span class="mini-glossary__count">{group.terms.length}</span>
                </summary>
                <dl>
                  {group.terms.map((entry) => (
                    <div>
                      <dt>{entry.term}</dt>
                      <dd>{entry.definition}</dd>
                    </div>
                  ))}
                </dl>
              </details>
            ))}
          </section>
        )
      }
    </article>
  </div>

  <TermTooltips />
</BaseLayout>

<script>
  import { initProgress, $progress } from "~/lib/progress";
  import { $role, initRole } from "~/lib/role";

  initProgress();
  initRole();

  /** This step's tier on the chosen route: "t", "o", "i", or null when the route skips it. */
  const tierOf = (step: HTMLElement, state: string) => {
    for (const part of (step.dataset.tiers ?? "").split(" ")) {
      const [owner, tier] = part.split(":");
      if (owner === state) return tier ?? null;
    }
    return null;
  };

  const box = document.querySelector<HTMLElement>("[data-start]");
  if (box) {
    const link = box.querySelector<HTMLAnchorElement>("[data-start-link]")!;
    const text = box.querySelector<HTMLElement>("[data-wave-label]")!;
    const meta = box.querySelector<HTMLElement>("[data-wave-detail]")!;
    // Scoped to the box: the step list renders a counter under the same
    // attribute, and it owns that one.
    const count = box.querySelector<HTMLElement>("[data-progress-done]")!;
    const bar = box.querySelector<HTMLElement>("[data-progress-bar]")!;
    const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-step]"));

    const update = () => {
      const progress = $progress.get();
      const state = $role.get();
      const open = (step: HTMLElement) => !progress.topics[step.dataset.step!]?.done;
      // With a role: the first open core step of its route here, then any open step.
      const core = state && state !== "all" ? steps.find((step) => open(step) && /^[to]$/.test(tierOf(step, state) ?? "")) : undefined;
      const pending = core ?? steps.find(open);
      const done = steps.filter((step) => progress.topics[step.dataset.step!]?.done).length;

      count.textContent = String(done);
      bar.style.inlineSize = steps.length ? String((done / steps.length) * 100) + "%" : "0%";

      const target = pending ?? steps[0];
      if (!target) return;

      const anchor = target.querySelector<HTMLAnchorElement>(".step__link");
      if (anchor) {
        link.href = anchor.getAttribute("href")!;
        // Read the title element, not the whole link: the link also carries the
        // step number and its reading time.
        meta.textContent = anchor.querySelector<HTMLElement>(".step__title")?.textContent?.trim() ?? "";
      }

      text.textContent = !pending ? "Baştan geç" : done > 0 ? "Devam et" : "Başla";
    };

    $progress.subscribe(update);
    $role.subscribe(update);
  }
</script>

<style>
  .category {
    display: grid;
    gap: var(--spacing-8);
    max-width: 90rem;
    margin-inline: auto;
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-16);
  }

  /* Phone: content first, step list after it. Desktop: list becomes the rail.
     The main column is a reading panel, like a lesson page. */
  .category__main {
    order: 1;
    min-width: 0;
    inline-size: 100%;
    max-inline-size: 46rem;
    margin-inline: auto;
    padding: var(--spacing-6) var(--spacing-4) var(--spacing-8);
    border: 1px solid var(--c-border);
    border-radius: 1.5rem;
    background-color: var(--c-surface-reading);
    box-shadow: var(--elev-card);
  }

  @media (min-width: 40rem) {
    .category__main {
      padding: var(--spacing-12);
    }
  }

  .category__rail {
    order: 2;
  }

  .category__head {
    position: relative;
  }

  /* The category's planet from the home map, so the two pages feel connected. */
  .category__planet {
    display: block;
    inline-size: 4.5rem;
    margin-block-end: var(--spacing-6);
  }

  .category__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-secondary);
  }

  .category__eyebrow::before {
    content: "";
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background-color: var(--area);
  }

  .category__title {
    margin-block: var(--spacing-2) var(--spacing-4);
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* ----------------------------------------------------------------- facts */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    margin: 0;
  }

  .facts {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .facts b {
    font-weight: 600;
    color: var(--c-text);
  }

  .facts__life {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  /* ------------------------------------------------------------ route stop */
  .route-stop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-4);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .route-stop__tier {
    padding: 0 var(--spacing-2);
    border: 1px solid var(--c-text-secondary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-text);
  }

  .route-stop__tier[data-tier="t"] {
    border-color: var(--c-text);
    background-color: var(--c-text);
    color: var(--c-surface);
  }

  .route-stop__tier[data-tier="i"] {
    border-style: dashed;
    color: var(--c-text-secondary);
  }

  .route-stop--off {
    padding: var(--spacing-2) var(--spacing-3);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-md);
  }

  /* ----------------------------------------------------------------- start */
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-4);
    margin-block-start: var(--spacing-8);
  }

  .start__progress {
    flex: 1 1 8rem;
    min-inline-size: 8rem;
  }

  .start__count {
    flex: 0 0 auto;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .category__offline {
    margin-block-start: var(--spacing-6);
  }

  .category__intro {
    margin-block-start: var(--spacing-8);
  }

  .category__intro :global(p:first-child) {
    margin-block-start: 0;
  }

  /* ------------------------------------------------------------ lesson path */
  .mini-glossary {
    margin-block-start: var(--spacing-12);
  }

  .path__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-muted);
  }

  .path__num {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  .mini-glossary__hint {
    margin-block: var(--spacing-2) var(--spacing-4);
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  .mini-glossary__group {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  .mini-glossary__group + .mini-glossary__group {
    margin-block-start: var(--spacing-2);
  }

  .mini-glossary__group summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    min-height: 44px;
    padding: var(--spacing-2) var(--spacing-4);
    cursor: pointer;
    font-weight: 500;
  }

  .mini-glossary__count {
    margin-inline-start: auto;
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  .mini-glossary__group dl {
    display: grid;
    gap: var(--spacing-3);
    margin: 0;
    padding: 0 var(--spacing-4) var(--spacing-4);
  }

  .mini-glossary__group dt {
    font-weight: 600;
    color: var(--c-text);
  }

  .mini-glossary__group dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-text-secondary);
  }

  @media (min-width: 64rem) {
    .category {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--spacing-12);
      padding-inline: var(--spacing-6);
      align-items: start;
    }

    .category__rail {
      order: 0;
      position: sticky;
      inset-block-start: var(--spacing-8);
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  }
</style>
