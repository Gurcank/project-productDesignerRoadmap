---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SearchField from "~/components/ui/SearchField.astro";
import { ROLE_IDS, ROLE_LABEL } from "~/data/role-ids";

// The search index names roles by their display name (topic pages, rol: filter).
const roleNames = Object.fromEntries(ROLE_IDS.map((id) => [id, ROLE_LABEL[id].name]));

const SUGGESTIONS = ["focus ring", "token", "API", "deploy", "kontrast", "prompt"];
---

<BaseLayout title="Ara" description="Tüm derslerde tam metin arama." section="ara">
  <div class="search">
    <h1 class="sr-only">Ara</h1>

    <form class="search__form" role="search" data-search-form>
      <SearchField
        id="q"
        name="q"
        label="Tüm derslerde ara"
        placeholder="Tüm derslerde ara…"
        autofocus
        attrs={{ "data-search-input": true }}
      />
    </form>

    <p class="search__status" role="status" aria-live="polite" data-search-status></p>

    <div class="suggestions" data-suggestions>
      <p class="suggestions__label">Şunlardan biriyle başla</p>
      <div class="suggestions__list">
        {SUGGESTIONS.map((term) => <button type="button" class="chip" data-suggest>{term}</button>)}
      </div>
    </div>

    <div class="filters" data-role-filter hidden>
      <span class="filters__label">Rolün</span>
      <div class="filters__list">
        <button type="button" class="filters__chip" aria-pressed="false" data-role-chip></button>
      </div>
    </div>

    <div class="filters" data-filters hidden>
      <span class="filters__label">Kategori</span>
      <div class="filters__list" data-filter-list></div>
    </div>

    <ol class="results" data-results></ol>

    <template data-result-template>
      <li class="result">
        <p class="result__category" data-field="category"></p>
        <h2 class="result__title"><a data-field="link"></a></h2>
        <p class="result__excerpt" data-field="excerpt"></p>
      </li>
    </template>
  </div>
</BaseLayout>

<script is:inline define:vars={{ roleNames }}>
  // is:inline on purpose. Pagefind writes its runtime into dist/ after the build,
  // so it is never in the module graph. When Astro bundles this script, Rollup
  // wraps the dynamic import in its preload helper and leaves an unreplaced
  // __VITE_PRELOAD__ behind, which throws — and the page then reports "no index"
  // on a site that has a perfectly good one. Neither a vite-ignore comment nor
  // rollup's `external` prevents that wrapper. Left inline, the import reaches
  // the browser exactly as written. The cost: plain JS here, no npm imports.
  const form = document.querySelector("[data-search-form]");
  const input = document.querySelector("[data-search-input]");
  const statusLine = document.querySelector("[data-search-status]");
  const list = document.querySelector("[data-results]");
  const template = document.querySelector("[data-result-template]");
  const filterBox = document.querySelector("[data-filters]");
  const filterList = document.querySelector("[data-filter-list]");
  const suggestions = document.querySelector("[data-suggestions]");

  let pagefind = null;
  let activeCategory = null;

  // With a role chosen, one chip narrows the results to that route's core
  // lessons (temel and önerilen: the rol filter on topic pages). Off by default.
  const roleName = roleNames[document.documentElement.dataset.role] || null;
  const roleBox = document.querySelector("[data-role-filter]");
  const roleChip = document.querySelector("[data-role-chip]");
  let roleOnly = false;
  if (roleName && roleBox && roleChip) {
    roleChip.textContent = "Yalnız " + roleName + " yolu";
    roleChip.addEventListener("click", () => {
      roleOnly = !roleOnly;
      roleChip.setAttribute("aria-pressed", String(roleOnly));
      run(input ? input.value : "");
    });
  }

  const say = (message) => {
    if (statusLine) statusLine.textContent = message;
  };

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import("/pagefind/pagefind.js");
      await pagefind.init();
      // Filter counts are loaded lazily; without this first call every search
      // reports empty counts and the category chips never appear.
      await pagefind.filters();
      return pagefind;
    } catch (error) {
      say("Arama dizini yok. Önce npm run build çalıştır (dev sunucusu son derlemenin dizinini kullanır).");
      return null;
    }
  }

  function renderFilters(counts) {
    if (!filterBox || !filterList) return;
    const categories = counts.kategori || {};
    const names = Object.keys(categories).filter((name) => categories[name] > 0);

    if (names.length < 2) {
      filterBox.hidden = true;
      return;
    }

    filterList.replaceChildren();
    for (const name of names.sort((a, b) => a.localeCompare(b, "tr"))) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "filters__chip";
      button.textContent = name + " (" + categories[name] + ")";
      button.setAttribute("aria-pressed", String(activeCategory === name));
      button.addEventListener("click", () => {
        activeCategory = activeCategory === name ? null : name;
        run(input ? input.value : "");
      });
      filterList.append(button);
    }
    filterBox.hidden = false;
  }

  async function run(query) {
    const trimmed = query.trim();

    // Keep the address bar in step so a result list can be shared as a link.
    const url = new URL(location.href);
    if (trimmed) url.searchParams.set("q", trimmed);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);

    if (!list || !template) return;

    if (suggestions) suggestions.hidden = trimmed.length > 0;

    if (roleBox) roleBox.hidden = !roleName || trimmed.length < 2;

    if (trimmed.length < 2) {
      list.replaceChildren();
      if (filterBox) filterBox.hidden = true;
      say(trimmed ? "En az iki karakter yaz." : "");
      return;
    }

    const api = await loadPagefind();
    if (!api) return;

    say("Aranıyor…");
    const filters = {};
    if (activeCategory) filters.kategori = [activeCategory];
    if (roleOnly && roleName) filters.rol = [roleName];
    const search = await api.search(trimmed, Object.keys(filters).length ? { filters } : undefined);

    // totalFilters counts the whole query, not just the active filter, so the
    // other chips stay visible while one is selected. (`filters` comes back empty.)
    renderFilters(search.totalFilters || search.filters || {});

    const top = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
    list.replaceChildren();

    for (const item of top) {
      const node = template.content.cloneNode(true);
      const link = node.querySelector('[data-field="link"]');
      link.href = item.url;
      link.textContent = item.meta.title || item.url;
      node.querySelector('[data-field="category"]').textContent = item.meta.kategori || "";
      // Pagefind returns the excerpt with <mark> around the hit, which is the
      // whole point of showing it.
      node.querySelector('[data-field="excerpt"]').innerHTML = item.excerpt;
      list.append(node);
    }

    const total = search.results.length;
    say(total === 0 ? '"' + trimmed + '" için sonuç yok.' : total + " sonuç bulundu.");
  }

  if (form) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      run(input ? input.value : "");
    });
  }

  let debounce;
  if (input) {
    input.addEventListener("input", () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => run(input.value), 200);
    });
  }

  // Example searches for an empty box: tap one to run it.
  for (const chip of document.querySelectorAll("[data-suggest]")) {
    chip.addEventListener("click", () => {
      if (!input) return;
      input.value = chip.textContent || "";
      input.dispatchEvent(new Event("input", { bubbles: true }));
    });
  }

  // A shared /ara?q=… link must land on its results, not an empty box.
  const initial = new URL(location.href).searchParams.get("q");
  if (initial && input) {
    input.value = initial;
    run(initial);
  }
</script>

<style>
  .search {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--spacing-16) var(--spacing-4) var(--spacing-16);
  }

  .search__form :global(.search-field) {
    min-block-size: 64px;
    padding-inline-start: var(--spacing-6);
  }

  .search__form :global(.search-field__input) {
    font-size: var(--text-lg);
  }

  .search__status {
    margin-block-start: var(--spacing-4);
    min-block-size: 1.5em;
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    text-align: center;
  }

  /* --------------------------------------------------------- suggestions */
  .suggestions {
    margin-block-start: var(--spacing-6);
    text-align: center;
  }

  .suggestions[hidden] {
    display: none;
  }

  .suggestions__label {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  .suggestions__list,
  .filters__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
  }

  .chip,
  .filters__list :global(.filters__chip) {
    min-block-size: 36px;
    padding-inline: var(--spacing-4);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    background-color: var(--c-glass);
    color: var(--c-text-secondary);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--e-out),
      color var(--dur) var(--e-out);
  }

  .chip:hover,
  .filters__list :global(.filters__chip:hover) {
    border-color: var(--c-action);
    color: var(--c-text);
  }

  .filters__list :global(.filters__chip[aria-pressed="true"]) {
    border-color: var(--c-action);
    background-color: color-mix(in oklab, var(--c-action) 18%, transparent);
    color: var(--c-text);
    font-weight: 600;
  }

  /* --------------------------------------------------------------- filters */
  .filters {
    margin-block-start: var(--spacing-6);
    text-align: center;
  }

  .filters__label {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
  }

  /* --------------------------------------------------------------- results */
  .results {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-8);
    padding: 0;
    list-style: none;
  }

  .result {
    position: relative;
    padding: var(--spacing-4) var(--spacing-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-glass-strong);
    transition:
      border-color var(--dur) var(--e-out),
      translate var(--dur) var(--e-out);
  }

  .result:hover {
    border-color: color-mix(in oklab, var(--c-action) 50%, var(--c-border));
    translate: 0 -2px;
  }

  .result:focus-within {
    border-color: var(--c-focus);
  }

  .result__category {
    display: inline-block;
    padding: 0 var(--spacing-2);
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--c-action) 14%, transparent);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-action);
  }

  .result__title {
    margin-block-start: var(--spacing-2);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  /* The whole card is the link target. */
  .result__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  .result__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .result__title a:focus-visible {
    outline: none;
  }

  .result__excerpt {
    margin-block-start: var(--spacing-2);
    color: var(--c-text-secondary);
    line-height: 1.6;
  }

  /* Pagefind wraps the hit in <mark>; redrawn as weight plus an action-colour
     underline. :global because the excerpt is injected at runtime. */
  .result__excerpt :global(mark) {
    background: none;
    color: var(--c-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--c-action);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .search {
      padding-inline: var(--spacing-6);
    }
  }
</style>
