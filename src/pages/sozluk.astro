---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SearchField from "~/components/ui/SearchField.astro";
import { getGlossary, homonymTerms, TURKISH_LETTERS } from "~/lib/glossary";

const entries = await getGlossary();
const homonyms = homonymTerms(entries);

const byLetter = new Map<string, typeof entries>();
for (const entry of entries) {
  const bucket = byLetter.get(entry.letter) ?? [];
  bucket.push(entry);
  byLetter.set(entry.letter, bucket);
}

const letters = [...TURKISH_LETTERS, "#"].filter((letter) => byLetter.has(letter));
---

<BaseLayout title="Sözlük" description={`${entries.length} terim, hepsi kendi dersine bağlı.`} section="sozluk">
  <div class="glossary">
    <header class="glossary__head">
      <h1>Sözlük</h1>
      <span class="glossary__total">{entries.length} terim</span>
    </header>

    {/* Search and the letter strip stay pinned while the list scrolls under them. */}
    <div class="finder">
      <SearchField id="glossary-filter" label="Terim ara" placeholder="Terim ara: token, pull request…" attrs={{ "data-filter": true }}>
        <span class="finder__count" role="status" data-filter-status></span>
      </SearchField>

      <nav class="letters" aria-label="Harfe git" data-letters>
        {letters.map((letter) => <a href={`#harf-${letter}`}>{letter}</a>)}
      </nav>
    </div>

    {
      letters.map((letter) => (
        <section class="letter" aria-labelledby={`harf-${letter}`} data-letter-section={letter}>
          <h2 class="letter__title" id={`harf-${letter}`}>
            {letter}
          </h2>

          <ul class="terms">
            {(byLetter.get(letter) ?? []).map((entry) => (
              <li class="term" data-term={`${entry.term} ${entry.english ?? ""}`.toLocaleLowerCase("tr")}>
                <h3 class="term__name">
                  <a class="term__link" href={entry.href}>
                    {entry.term}
                  </a>
                  {homonyms.has(entry.term.toLocaleLowerCase("tr")) && (
                    <span class="term__context">{entry.categoryTitle}</span>
                  )}
                </h3>
                {entry.definition && <p class="term__definition">{entry.definition}</p>}
                <p class="term__source">{entry.topicTitle}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="glossary__empty" data-empty hidden>
      <p class="glossary__empty-title">Bu aramaya uyan terim yok</p>
      <p>Daha kısa bir kelime dene ya da tüm sitede ara.</p>
      <a class="glossary__empty-link" href="/ara/" data-search-everywhere>Tüm sitede ara →</a>
    </div>
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-filter]");
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const everywhere = document.querySelector<HTMLAnchorElement>("[data-search-everywhere]");
  const terms = Array.from(document.querySelectorAll<HTMLElement>("[data-term]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-letter-section]"));
  const letterNav = document.querySelector<HTMLElement>("[data-letters]");

  if (input) {
    const total = terms.length;

    const apply = () => {
      const query = input.value.trim().toLocaleLowerCase("tr");
      let shown = 0;

      for (const term of terms) {
        const match = query === "" || (term.dataset.term ?? "").includes(query);
        term.hidden = !match;
        if (match) shown += 1;
      }

      // A letter heading with nothing under it is noise.
      for (const section of sections) {
        section.hidden = !section.querySelector<HTMLElement>("[data-term]:not([hidden])");
      }

      if (letterNav) letterNav.hidden = query !== "";
      if (empty) empty.hidden = shown > 0;
      if (everywhere) everywhere.href = `/ara/?q=${encodeURIComponent(input.value.trim())}`;
      if (status) status.textContent = query === "" ? "" : `${shown} / ${total}`;
    };

    input.addEventListener("input", apply);
    apply();
  }
</script>

<style>
  /* A letter link crosses up to ~200 000 px; a smooth scroll that long is slow and
     any layout change on the way (images, fonts) drops it short of the target. */
  :global(html) {
    scroll-behavior: auto;
  }

  .glossary {
    max-width: 64rem;
    margin-inline: auto;
    padding: var(--spacing-12) var(--spacing-4) var(--spacing-16);
  }

  .glossary__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--spacing-3) var(--spacing-4);
  }

  .glossary__head h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
  }

  .glossary__total {
    padding: var(--spacing-1) var(--spacing-3);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-secondary);
  }

  /* ----------------------------------------------------------------- finder */
  .finder {
    position: sticky;
    inset-block-start: var(--spacing-3);
    z-index: var(--z-sticky);
    display: grid;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-6);
  }

  .finder__count {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  /* One row of letter chips; scrolls sideways on a phone instead of wrapping. */
  .letters {
    display: flex;
    gap: var(--spacing-1);
    padding: var(--spacing-1);
    overflow-x: auto;
    scrollbar-width: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    background-color: var(--c-glass-strong);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .letters[hidden] {
    display: none;
  }

  .letters a {
    flex: none;
    display: grid;
    place-items: center;
    min-inline-size: 36px;
    min-block-size: 36px;
    border-radius: var(--radius-full);
    color: var(--c-text-secondary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .letters a:hover,
  .letters a:focus-visible {
    background-color: color-mix(in oklab, var(--c-action) 18%, transparent);
    color: var(--c-text);
  }

  /* ----------------------------------------------------------------- terms */
  /* No content-visibility here: skipped sections are laid out at a guessed height,
     so a letter link scrolled to a spot that moved as the sections above it were
     measured — the "click twice" bug. 800 plain cards are cheap to lay out. */
  .letter {
    margin-block-start: var(--spacing-12);
  }

  .letter__title {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    font-size: var(--text-2xl);
    color: var(--c-action);
    scroll-margin-top: 9rem;
  }

  .letter__title::after {
    content: "";
    flex: 1 1 auto;
    block-size: 1px;
    background: linear-gradient(to right, var(--c-border-strong), transparent);
  }

  .terms {
    display: grid;
    gap: var(--spacing-3);
    margin-block-start: var(--spacing-4);
    padding: 0;
    list-style: none;
  }

  /* Solid-ish cards, no blur: 800 blurred layers would cost every frame. */
  .term {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: var(--spacing-4) var(--spacing-6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background-color: var(--c-glass-strong);
    transition:
      border-color var(--dur) var(--e-out),
      translate var(--dur) var(--e-out);
  }

  .term:hover {
    border-color: color-mix(in oklab, var(--c-action) 50%, var(--c-border));
    translate: 0 -2px;
  }

  .term:focus-within {
    border-color: var(--c-focus);
  }

  .term__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-1) var(--spacing-3);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  /* The whole card opens the lesson; the name is the link. */
  .term__link {
    color: var(--c-text);
    text-decoration: none;
  }

  .term__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .term__link:focus-visible {
    outline: none;
  }

  /* Homonyms are the reason this site needs a glossary at all — "Tag" is three
     different words. The context is part of the name, not a footnote. */
  .term__context {
    padding: 0 var(--spacing-2);
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--c-focus) 16%, transparent);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--c-focus);
  }

  .term__definition {
    color: var(--c-text-secondary);
    line-height: 1.6;
  }

  .term__source {
    margin-block-start: auto;
    padding-block-start: var(--spacing-1);
    font-size: var(--text-xs);
    color: var(--c-text-muted);
  }

  .term__source::before {
    content: "↳ ";
  }

  /* ----------------------------------------------------------------- empty */
  .glossary__empty {
    margin-block-start: var(--spacing-12);
    padding: var(--spacing-8);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--c-text-secondary);
  }

  .glossary__empty[hidden] {
    display: none;
  }

  .glossary__empty-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--c-text);
  }

  .glossary__empty-link {
    display: inline-flex;
    margin-block-start: var(--spacing-4);
    min-block-size: 24px;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .glossary {
      padding-inline: var(--spacing-6);
    }

    .terms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-4);
    }
  }
</style>
