---
import "~/styles/global.css";
import MobileNav from "~/components/MobileNav.astro";
import SiteNav from "~/components/SiteNav.astro";
import Starfield from "~/components/Starfield.astro";
import { NAV, type NavId } from "~/data/nav";
import { ROLE_AUTO_KEY, ROLE_KEY, ROLE_STATES } from "~/data/role-ids";
import { roleCss } from "~/lib/role-css";

interface Props {
  title: string;
  description?: string;
  /** Marks the active top-level section in the menus. */
  section?: NavId;
}

const { title, description = "Product Designer yol haritası — kişisel öğrenme sitesi.", section } = Astro.props;
const fullTitle = title === "Yol haritası" ? "Product Designer Yol Haritası" : `${title} · PD Yol Haritası`;

// Astro.site comes from astro.config; falls back so a preview build still works.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;


/*
 * The service worker is registered in production only. In dev it served the
 * previous build stale-while-revalidate, so an edit landed in the response but
 * not on screen — indistinguishable from a fix that did not work. Dev instead
 * tears down any worker an earlier session left behind, because declining to
 * register does not remove one that is already installed.
 *
 * The body is a string, not markup: `is:inline` treats a script's children as
 * raw text, so an expression inside the tag would be printed verbatim.
 */
const SERVICE_WORKER_SCRIPT = import.meta.env.PROD
  ? `if ("serviceWorker" in navigator) {
  window.addEventListener("load", function () {
    navigator.serviceWorker.register("/sw.js").catch(function () {
      /* Offline is an enhancement; the site works without it. */
    });
  });
}`
  : `if ("serviceWorker" in navigator) {
  navigator.serviceWorker.getRegistrations().then(function (registrations) {
    registrations.forEach(function (registration) {
      registration.unregister();
    });
  });
  if (window.caches) {
    caches.keys().then(function (keys) {
      keys.forEach(function (key) {
        caches.delete(key);
      });
    });
  }
}`;
---

<!doctype html>
<html lang="tr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#080e23" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    {/* Launch checklist 21.9: the link preview is what people actually see when
        the URL is pasted into a chat, and it is invisible until it is wrong. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Product Designer Yol Haritası" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {/* Reading size, star motion and the chosen role, applied before first paint
        so none of them flashes. Must stay inline and synchronous (ADR-007): a
        deferred copy would paint the Keşif map first and then jump. */}
    <script is:inline define:vars={{ roleStates: ROLE_STATES, roleKey: ROLE_KEY, autoKey: ROLE_AUTO_KEY }}>
      var root = document.documentElement;
      root.dataset.js = "";
      // A shared link may carry a role; it wins even when storage is blocked.
      var role = new URLSearchParams(location.search).get("rol");
      if (roleStates.indexOf(role) < 0) role = null;
      try {
        var size = localStorage.getItem("pdr.text-size");
        if (size === "sm" || size === "lg" || size === "xl") root.dataset.text = size;
        if (localStorage.getItem("pdr.stars") === "off") root.dataset.stars = "off";

        if (role) {
          localStorage.setItem(roleKey, role);
          localStorage.removeItem(autoKey);
        } else {
          role = localStorage.getItem(roleKey);
          if (roleStates.indexOf(role) < 0) role = null;
          // Someone who was already learning here came for the designer route;
          // keep their map as it was and tell them (home page note).
          if (!role && localStorage.getItem("pdr.progress.v1")) {
            role = "product-designer";
            localStorage.setItem(roleKey, role);
            localStorage.setItem(autoKey, "1");
          }
        }
        if (localStorage.getItem(autoKey)) root.dataset.roleAuto = "";
      } catch (error) {
        /* Private mode: defaults apply. */
      }
      if (role) root.dataset.role = role;
    </script>
    <style is:inline set:html={roleCss()}></style>
  </head>

  <body>
    <Starfield />
    <a class="skip" href="#main">Ana içeriğe atla</a>

    {/* Scroll position of the reading column. On a phone a topic page is a long
        scroll and there is no scrollbar to read it from. */}
    <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>

    {/* ≥64rem the menu is the left rail (ADR-016); below that, the bottom bar. */}
    <SiteNav items={NAV} section={section} />

    <p class="offline-banner" role="status" data-offline-banner hidden>
      İnternet yok — indirilmiş içerik gösteriliyor.
    </p>

    <main id="main">
      <slot />
    </main>

    <MobileNav items={NAV} section={section} />
    {/* Offline reading (ADR-012), production only — see SERVICE_WORKER_SCRIPT. */}
    <script is:inline set:html={SERVICE_WORKER_SCRIPT} />

    <script>
      // Offline is a normal state for this site (ADR-012); say so instead of
      // letting a missing page look like a bug.
      const banner = document.querySelector<HTMLElement>("[data-offline-banner]");
      if (banner) {
        const sync = () => (banner.hidden = navigator.onLine);
        window.addEventListener("online", sync);
        window.addEventListener("offline", sync);
        sync();
      }

      const bar = document.querySelector<HTMLElement>("[data-read-progress]");
      if (bar) {
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.inlineSize = max > 0 ? `${Math.min(100, (window.scrollY / max) * 100)}%` : "0%";
        };
        // passive: this listener must never delay the scroll it is reporting on.
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-block-start: var(--spacing-2);
    inset-inline-start: var(--spacing-2);
    z-index: var(--z-toast);
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-md);
    background-color: var(--c-surface-overlay);
    color: var(--c-text);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: translateY(0);
  }

  .offline-banner {
    margin: 0;
    padding: var(--spacing-2) var(--spacing-4);
    border-bottom: 1px solid var(--c-border);
    background-color: var(--c-surface-raised);
    color: var(--c-text-secondary);
    font-size: var(--text-sm);
    text-align: center;
  }

  .offline-banner[hidden] {
    display: none;
  }

  .read-progress {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: var(--z-overlay);
    block-size: 2px;
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    block-size: 100%;
    inline-size: 0;
    background-color: var(--c-progress);
  }

  /* Desktop has a scrollbar; this is a phone affordance. */
  @media (min-width: 48rem) {
    .read-progress {
      display: none;
    }
  }

  /* Room for the closed rail, so it never sits on top of a page's first column. */
  @media (min-width: 64rem) {
    main {
      padding-inline-start: 5.5rem;
    }
  }
</style>
